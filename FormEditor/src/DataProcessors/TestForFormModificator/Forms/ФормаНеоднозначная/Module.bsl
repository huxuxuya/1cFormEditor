&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	ОшибкаПолучена = Ложь;
	Попытка
		РедакторФорм.НовоеПолеФормыРеквизитОбъекта(Контекст, "РеквизитСтрока");
	Исключение
		ОшибкаПолучена = СтрНайти(ОписаниеОшибки(), "Несколько объектных реквизитов") > 0;
	КонецПопытки;
	Если Не ОшибкаПолучена Тогда
		ВызватьИсключение "Не обработана неоднозначность реквизитов";
	КонецЕсли;
	Контекст.ИмяРеквизитаОбъекта = "ВторойОбъект";
	Поле = РедакторФорм.НовыйРеквизитОбъектаФормы(Контекст, "РеквизитБулево");
	Если Поле.ПутьКДанным <> "ВторойОбъект.РеквизитБулево"
		Или Поле.Вид <> ВидПоляФормы.ПолеФлажка Тогда
		ВызватьИсключение "Неверно определен объектный реквизит или вид поля";
	КонецЕсли;
	ПолеСтроки = РедакторФорм.НовоеПолеФормыРеквизитОбъекта(Контекст, "РеквизитСтрока");
	Если ПолеСтроки.ПутьКДанным <> "ВторойОбъект.РеквизитСтрока" Тогда
		ВызватьИсключение "Путь предыдущего поля перенесен в следующее";
	КонецЕсли;

КонецПроцедуры
