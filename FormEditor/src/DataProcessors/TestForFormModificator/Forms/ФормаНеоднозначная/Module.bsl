#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Результаты = Новый Массив;
	ПроверитьАвтоматическоеОпределение(Результаты);
	ПроверитьЯвныйВыборОбъекта(Результаты);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Результаты);
	РезультатыПроверокJSON = ЗаписьJSON.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПроверитьАвтоматическоеОпределение(Результаты)

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Элемент = Неопределено;
	Ошибка = "";
	Ожидаемое = "Исключение о нескольких объектных реквизитах";
	Попытка
		Элемент = РедакторФорм.НовоеПолеФормыРеквизитОбъекта(Контекст, "РеквизитСтрока");
		Результаты.Добавить(Новый Структура("id,status,description,expected,actual,error",
			"ФормаНеоднозначная", "FAIL", "Автоопределение отклоняет неоднозначность двух объектных реквизитов",
			Ожидаемое, "Поле создано с путем " + Элемент.ПутьКДанным, "Не обработана неоднозначность реквизитов"));
	Исключение
		Ошибка = ОписаниеОшибки();
		Если СтрНайти(Ошибка, "Несколько объектных реквизитов") > 0 Тогда
			Результаты.Добавить(Новый Структура("id,status,description,expected,actual,error",
				"ФормаНеоднозначная", "PASS", "Автоопределение отклоняет неоднозначность двух объектных реквизитов",
				Ожидаемое, Ошибка, ""));
		Иначе
			Результаты.Добавить(Новый Структура("id,status,description,expected,actual,error",
				"ФормаНеоднозначная", "FAIL", "Автоопределение отклоняет неоднозначность двух объектных реквизитов",
				Ожидаемое, "Получено другое исключение: " + Ошибка,
				"Не обработана неоднозначность реквизитов; фактическая ошибка: " + Ошибка));
		КонецЕсли;
	КонецПопытки;

	Если Элемент <> Неопределено Тогда
		Элементы.Удалить(Элемент);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПроверитьЯвныйВыборОбъекта(Результаты)

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Вставить("ИмяРеквизитаОбъекта", "ВторойОбъект");
	Элемент = Неопределено;
	Ожидаемое = "Путь ВторойОбъект.РеквизитБулево и вид ПолеФлажка";
	Попытка
		Элемент = РедакторФорм.НовыйРеквизитОбъектаФормы(Контекст, "РеквизитБулево");
		Фактическое = Элемент.ПутьКДанным + "; " + Строка(Элемент.Вид);
		Если Элемент.ПутьКДанным = "ВторойОбъект.РеквизитБулево"
			И Элемент.Вид = ВидПоляФормы.ПолеФлажка Тогда
			Результаты.Добавить(Новый Структура("id,status,description,expected,actual,error",
			"ФормаЯвныйВыборРеквизита", "PASS", "Явный выбор ВторойОбъект проверяет путь и вид флажка",
				Ожидаемое, Фактическое, ""));
		Иначе
			Результаты.Добавить(Новый Структура("id,status,description,expected,actual,error",
				"ФормаЯвныйВыборРеквизита", "FAIL", "Явный выбор ВторойОбъект проверяет путь и вид флажка",
				Ожидаемое, Фактическое, "Выбранный объект или вид поля не совпал с ожидаемым"));
		КонецЕсли;
	Исключение
		Ошибка = ОписаниеОшибки();
		Результаты.Добавить(Новый Структура("id,status,description,expected,actual,error",
			"ФормаЯвныйВыборРеквизита", "FAIL", "Явный выбор ВторойОбъект проверяет путь и вид флажка",
			Ожидаемое, "Создание поля завершилось исключением: " + Ошибка, Ошибка));
	КонецПопытки;

	Если Элемент <> Неопределено Тогда
		Элементы.Удалить(Элемент);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
