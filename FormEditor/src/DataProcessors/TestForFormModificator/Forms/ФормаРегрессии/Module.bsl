&НаСервере
Процедура ПроверкаКонтекстПослеМногострочногоПоля()

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Многострочное = РедакторФорм.НовоеМногострочноеПолеРеквизитОбъекта(Контекст, "МногострочноеПоле");
	Поле = РедакторФорм.НовоеПолеФормыРеквизитОбъекта(Контекст, "РеквизитСтрока");
	ПроверитьУсловиеРегрессии(Многострочное.ПутьКДанным = "Объект.МногострочноеПоле" И Многострочное.МногострочныйРежим, "Путь и режим многострочного поля");
	ПроверитьУсловиеРегрессии(Поле.ПутьКДанным = "Объект.РеквизитСтрока", "Путь многострочного поля не перенесен на следующее");
	ПроверитьУсловиеРегрессии(Контекст.Свойства.Количество() = 0, "Многострочное поле не добавляет свойства в контекст");

КонецПроцедуры

&НаСервере
Процедура ПроверкаКонтекстПослеОшибки()

	Для Номер = 1 По 4 Цикл
		ИмяПоля = ?(Номер = 1, "РеквизитДобавитьПолеНаФорму", "РеквизитСтрока");
		ИсходноеПоле = Элементы.Добавить(ИмяПоля, Тип("ПолеФормы"));
		Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
		Контекст.Свойства.Вставить("ТолькоПросмотр", Истина);
		ОшибкаПолучена = Ложь;
		Попытка
			Если Номер = 1 Тогда
				РедакторФорм.НовоеПолеРеквизитаФормы(Контекст, ИмяПоля);
			ИначеЕсли Номер = 2 Тогда
				РедакторФорм.НовоеПолеФормыРеквизитОбъекта(Контекст, ИмяПоля);
			ИначеЕсли Номер = 3 Тогда
				РедакторФорм.НовоеПолеФлажокФормыРеквизитОбъекта(Контекст, ИмяПоля);
			Иначе
				РедакторФорм.НовоеМногострочноеПолеРеквизитОбъекта(Контекст, ИмяПоля);
			КонецЕсли;
		Исключение
			ОшибкаПолучена = Истина;
		КонецПопытки;
		ПроверитьУсловиеРегрессии(ОшибкаПолучена И Элементы.Найти(ИмяПоля) = ИсходноеПоле, "Дубликат отклонен, исходное поле сохранено: " + Строка(Номер));
		ПроверитьУсловиеРегрессии(Контекст.Свойства.Количество() = 1 И Контекст.Свойства.ТолькоПросмотр, "После ошибки контекст содержит только пользовательские свойства: " + Строка(Номер));
		Элементы.Удалить(ИсходноеПоле);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПроверкаЯвныеСвойства()

	Для Номер = 1 По 4 Цикл
		Путь = ?(Номер = 1, "РеквизитДобавитьПолеНаФорму", "Объект.РеквизитСтрока");
		Если Номер = 3 Тогда
			Путь = "Объект.РеквизитБулево";
		КонецЕсли;
		Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
		Контекст.Свойства.Вставить("ПутьКДанным", Путь);
		Если Номер = 1 Тогда
			Поле = РедакторФорм.НовоеПолеРеквизитаФормы(Контекст, "ИзоляцияЯвныйПуть");
		ИначеЕсли Номер = 2 Тогда
			Поле = РедакторФорм.НовоеПолеФормыРеквизитОбъекта(Контекст, "ИзоляцияЯвныйПуть");
		ИначеЕсли Номер = 3 Тогда
			Поле = РедакторФорм.НовоеПолеФлажокФормыРеквизитОбъекта(Контекст, "ИзоляцияЯвныйПуть");
		Иначе
			Поле = РедакторФорм.НовоеМногострочноеПолеРеквизитОбъекта(Контекст, "ИзоляцияЯвныйПуть");
		КонецЕсли;
		ПроверитьУсловиеРегрессии(Поле.ПутьКДанным = Путь, "Явный путь имеет приоритет над именем элемента: " + Строка(Номер));
		Элементы.Удалить(Поле);
	КонецЦикла;

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Лево);
	Флажок = РедакторФорм.НовыйРеквизитОбъектаФормы(Контекст, "РеквизитБулево");
	ПроверитьУсловиеРегрессии(Флажок.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево, "Сохранено явное положение заголовка флажка");

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("АвтоМаксимальнаяШирина", Ложь);
	Контекст.Свойства.Вставить("МаксимальнаяШирина", 42);
	Шапка = РедакторФорм.НовоеПолеШапкиФормыРеквизитОбъекта(Контекст, "РеквизитШапки");
	ПроверитьУсловиеРегрессии(Шапка.МаксимальнаяШирина = 42 И Контекст.Свойства.МаксимальнаяШирина = 42, "Сохранена явно заданная ширина поля шапки");

КонецПроцедуры

&НаСервере
Процедура ПроверитьУсловиеРегрессии(Условие, Описание)

	Если Не Условие Тогда
		ВызватьИсключение "Ошибка регрессионной проверки: " + Описание;
	КонецЕсли;

КонецПроцедуры

