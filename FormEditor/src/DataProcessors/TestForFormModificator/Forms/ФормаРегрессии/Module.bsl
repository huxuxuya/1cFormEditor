#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПроверитьОчисткуРазовыхСвойств();
	Попытка
		ПроверитьИсправленияОткрытыхЗадач();
		РезультатыПроверок = РезультатыПроверок + Символы.ПС + "PASS ОбщиеПроверки";
	Исключение
		РезультатыПроверок = РезультатыПроверок + Символы.ПС + "FAIL ОбщиеПроверки: " + СтрЗаменить(ОписаниеОшибки(), Символы.ПС, " ");
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Регрессионные проверки #6, #7 и #9 выполняются при открытии тестовой формы.
&НаСервере
Процедура ПроверитьИсправленияОткрытыхЗадач()

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("ПутьКДанным", "Объект.РеквизитСтрока");
	Контекст.Свойства.Вставить("Заголовок", "Разовый заголовок");
	Контекст.Свойства.Вставить("ТолькоПросмотр", Истина);
	Контекст.Обработчики.Вставить("ПриИзменении", "РегрессияПриИзменении");
	ПервоеПоле = РедакторФорм.НовоеПолеФормы(Контекст, "РегрессияПервоеПоле");
	ПроверитьУсловиеРегрессии(ПервоеПоле.ПутьКДанным = "Объект.РеквизитСтрока", "Путь первого поля");
	ПроверитьУсловиеРегрессии(ПервоеПоле.Заголовок = "Разовый заголовок", "Заголовок первого поля");
	ПроверитьУсловиеРегрессии(ПервоеПоле.ПолучитьДействие("ПриИзменении") = "РегрессияПриИзменении", "Обработчик первого поля");
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("ПутьКДанным"), "Очистка пути");
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("Заголовок"), "Очистка заголовка");
	ПроверитьУсловиеРегрессии(Контекст.Обработчики.Количество() = 0, "Очистка обработчиков");
	ВтороеПоле = РедакторФорм.НовоеПолеФормыРеквизитОбъекта(Контекст, "РеквизитШапки");
	ПроверитьУсловиеРегрессии(ВтороеПоле.ПутьКДанным = "Объект.РеквизитШапки", "Путь второго поля");
	ПроверитьУсловиеРегрессии(ВтороеПоле.ТолькоПросмотр, "Сохранение общих свойств");
	ПроверитьУсловиеРегрессии(Не ЗначениеЗаполнено(ВтороеПоле.ПолучитьДействие("ПриИзменении")), "Обработчик не перенесен на второе поле");

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("ПутьКДанным", "Объект.РеквизитБулево");
	Флажок = РедакторФорм.НовыйРеквизитОбъектаФормы(Контекст, "РегрессияФлажок");
	ПроверитьУсловиеРегрессии(Флажок.Вид = ВидПоляФормы.ПолеФлажка, "Тип по явному пути");
	ПроверитьУсловиеРегрессии(Флажок.Имя = "РегрессияФлажок", "Имя элемента не заменено именем реквизита");

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("Заголовок", "Разовый заголовок кнопки");
	Кнопка = РедакторФорм.НоваяКомандаИКнопкаФормы(Контекст, "РегрессияКоманда", "Заголовок по умолчанию");
	ПроверитьУсловиеРегрессии(Кнопка.Заголовок = "Разовый заголовок кнопки", "Заголовок дошел до кнопки");
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("Заголовок"), "Очистка составного вызова");

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("Заголовок", "Разовая группа");
	Группа = РедакторФорм.НоваяГруппаОбычная(Контекст, "РегрессияГруппа");
	ПроверитьУсловиеРегрессии(Группа.Заголовок = "Разовая группа", "Заголовок группы");
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("Заголовок"), "Очистка заголовка группы");

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("Заголовок", "Разовая таблица");
	Контекст.Обработчики.Вставить("ПриАктивизацииСтроки", "РегрессияПриАктивизацииСтроки");
	Колонки = Новый Структура("РегрессияИмяМетода", "ИмяМетода");
	Таблица = РедакторФорм.НоваяТаблицаФормы(Контекст, "РегрессияТаблица", "Объект.ПроверяемыеПроцедурыИФункции", Колонки);
	ПроверитьУсловиеРегрессии(Таблица.ПолучитьДействие("ПриАктивизацииСтроки") = "РегрессияПриАктивизацииСтроки", "Обработчик таблицы");
	ПроверитьУсловиеРегрессии(Элементы.РегрессияИмяМетода.ПутьКДанным = "Объект.ПроверяемыеПроцедурыИФункции.ИмяМетода", "Путь вложенной колонки");
	ПроверитьУсловиеРегрессии(Контекст.Обработчики.Количество() = 0, "Очистка обработчика таблицы");
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("Заголовок"), "Очистка заголовка таблицы");

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	МногострочноеПоле = РедакторФорм.НовоеМногострочноеПолеРеквизитОбъекта(Контекст, "МногострочноеПоле");
	ПроверитьУсловиеРегрессии(МногострочноеПоле.ПутьКДанным = "Объект.МногострочноеПоле", "Путь многострочного поля");
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("ПутьКДанным"), "Очистка пути многострочного поля");

	Элементы.Удалить(Элементы.РегрессияИмяМетода);
	Элементы.Удалить(Таблица);
	Элементы.Удалить(Группа);
	Элементы.Удалить(МногострочноеПоле);
	Элементы.Удалить(ПервоеПоле);
	Элементы.Удалить(ВтороеПоле);
	Элементы.Удалить(Флажок);
	Элементы.Удалить(Кнопка);
	Команды.Удалить(Команды.РегрессияКоманда);

КонецПроцедуры

// Сценарии выполняются независимо; все ошибки собираются до завершения набора.
&НаСервере
Процедура ПроверитьОчисткуРазовыхСвойств()

	Результаты = Новый Массив;
	ЕстьОшибки = Ложь;
	ВыполнитьПроверкуОчистки(1, "ГруппаКнопок", "ГруппаКнопокФормы0,РегрессияПанель", "", Результаты, ЕстьОшибки);
	ВыполнитьПроверкуОчистки(2, "Надпись", "РегрессияНадпись", "", Результаты, ЕстьОшибки);
	ВыполнитьПроверкуОчистки(3, "Команда", "", "РегрессияОтдельнаяКоманда", Результаты, ЕстьОшибки);
	ВыполнитьПроверкуОчистки(4, "КнопкаПанели", "РегрессияКомандаПанели", "РегрессияКомандаПанели", Результаты, ЕстьОшибки);
	ВыполнитьПроверкуОчистки(5, "Гиперссылка", "РегрессияСсылка", "РегрессияСсылка", Результаты, ЕстьОшибки);
	ВыполнитьПроверкуОчистки(6, "ГруппаФормы", "РегрессияГруппаФормы", "", Результаты, ЕстьОшибки);
	ВыполнитьПроверкуОчистки(7, "ГруппаКолонок", "РегрессияКолонкиЛево,РегрессияКолонкиПраво,РегрессияКолонки", "", Результаты, ЕстьОшибки);
	ВыполнитьПроверкуОчистки(8, "ПолеРеквизитаФормы", "РеквизитДобавитьПолеНаФорму", "", Результаты, ЕстьОшибки);
	ВыполнитьПроверкуОчистки(9, "ПолеШапки", "РеквизитШапки", "", Результаты, ЕстьОшибки);
	ВыполнитьПроверкуОчистки(10, "Флажок", "РеквизитБулево", "", Результаты, ЕстьОшибки);
	ВыполнитьПроверкуОчистки(11, "ОшибкаДубликата", "РегрессияДубликат", "", Результаты, ЕстьОшибки);
	ВыполнитьПроверкуОчистки(12, "ДинамическийСписок", "", "", Результаты, ЕстьОшибки);
	ВыполнитьПроверкуОчистки(13, "КонтекстПослеГруппы", "ИзоляцияПоле,ИзоляцияКолонкиЛево,ИзоляцияКолонкиПраво,ИзоляцияКолонки", "", Результаты, ЕстьОшибки);
	ВыполнитьПроверкуОчистки(14, "КонтекстПослеФлажка", "РеквизитБулево,РеквизитСтрока", "", Результаты, ЕстьОшибки);
	ВыполнитьПроверкуОчистки(15, "КонтекстПослеШапки", "РеквизитШапки,РеквизитСтрока", "", Результаты, ЕстьОшибки);
	ВыполнитьПроверкуОчистки(16, "КонтекстПослеМногострочногоПоля", "МногострочноеПоле,РеквизитСтрока", "", Результаты, ЕстьОшибки);
	ВыполнитьПроверкуОчистки(17, "КонтекстПослеОшибки", "РеквизитСтрока,РеквизитДобавитьПолеНаФорму", "", Результаты, ЕстьОшибки);
	ВыполнитьПроверкуОчистки(18, "ЯвныеСвойства", "ИзоляцияЯвныйПуть,РеквизитБулево,РеквизитШапки", "", Результаты, ЕстьОшибки);
	РезультатыПроверок = СтрСоединить(Результаты, Символы.ПС);


КонецПроцедуры

&НаСервере
Процедура ВыполнитьПроверкуОчистки(Номер, Имя, ИменаЭлементов, ИменаКоманд, Результаты, ЕстьОшибки)

	Ошибка = "";
	Попытка
		Если Номер = 1 Тогда
			ПроверкаГруппаКнопок();
		ИначеЕсли Номер = 2 Тогда
			ПроверкаНадпись();
		ИначеЕсли Номер = 3 Тогда
			ПроверкаКоманда();
		ИначеЕсли Номер = 4 Тогда
			ПроверкаКнопкаПанели();
		ИначеЕсли Номер = 5 Тогда
			ПроверкаГиперссылка();
		ИначеЕсли Номер = 6 Тогда
			ПроверкаГруппаФормы();
		ИначеЕсли Номер = 7 Тогда
			ПроверкаГруппаКолонок();
		ИначеЕсли Номер = 8 Тогда
			ПроверкаПолеРеквизитаФормы();
		ИначеЕсли Номер = 9 Тогда
			ПроверкаПолеШапки();
		ИначеЕсли Номер = 10 Тогда
			ПроверкаФлажок();
		ИначеЕсли Номер = 11 Тогда
			ПроверкаОшибкаДубликата();
		ИначеЕсли Номер = 12 Тогда
			ПроверкаДинамическийСписок();
		ИначеЕсли Номер = 13 Тогда
			ПроверкаКонтекстПослеГруппы();
		ИначеЕсли Номер = 14 Тогда
			ПроверкаКонтекстПослеФлажка();
		ИначеЕсли Номер = 15 Тогда
			ПроверкаКонтекстПослеШапки();
		ИначеЕсли Номер = 16 Тогда
			ПроверкаКонтекстПослеМногострочногоПоля();
		ИначеЕсли Номер = 17 Тогда
			ПроверкаКонтекстПослеОшибки();
		ИначеЕсли Номер = 18 Тогда
			ПроверкаЯвныеСвойства();
		КонецЕсли;
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Попытка
		Для Каждого ИмяЭлемента Из СтрРазделить(ИменаЭлементов, ",", Ложь) Цикл
			Элемент = Элементы.Найти(ИмяЭлемента);
			Если Элемент <> Неопределено Тогда
				Элементы.Удалить(Элемент);
			КонецЕсли;
		КонецЦикла;
		Если Номер = 12 Тогда
			УдаляемыеРеквизиты = Новый Массив;
			УдаляемыеРеквизиты.Добавить("РегрессияДинамическийСписок");
			ИзменитьРеквизиты(Новый Массив, УдаляемыеРеквизиты);
		КонецЕсли;
		Для Каждого ИмяКоманды Из СтрРазделить(ИменаКоманд, ",", Ложь) Цикл
			Команда = Команды.Найти(ИмяКоманды);
			Если Команда <> Неопределено Тогда
				Команды.Удалить(Команда);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Ошибка = Ошибка + " Ошибка очистки: " + ОписаниеОшибки();
	КонецПопытки;

	Если ЗначениеЗаполнено(Ошибка) Тогда
		ЕстьОшибки = Истина;
		Результаты.Добавить("FAIL " + Имя + ": " + СтрЗаменить(Ошибка, Символы.ПС, " "));
	Иначе
		Результаты.Добавить("PASS " + Имя);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПроверкаГруппаКнопок()

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Панель = Элементы.Добавить("РегрессияПанель", Тип("ГруппаФормы"));
	Панель.Вид = ВидГруппыФормы.КоманднаяПанель;
	Контекст.Родитель = Панель;
	Контекст.Свойства.Вставить("Заголовок", "Группа кнопок");
	Группа = РедакторФорм.НоваяГруппаКнопок(Контекст);
	ПроверитьУсловиеРегрессии(Группа.Заголовок = "Группа кнопок", "Заголовок группы кнопок");
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("Заголовок"), "Очистка группы кнопок");
	Элементы.Удалить(Группа);
	Элементы.Удалить(Панель);
	Контекст.Родитель = Неопределено;

КонецПроцедуры

&НаСервере
Процедура ПроверкаНадпись()

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("Заголовок", "Надпись");
	Надпись = РедакторФорм.НоваяДекорацияНадпись(Контекст, "РегрессияНадпись");
	ПроверитьУсловиеРегрессии(Надпись.Заголовок = "Надпись", "Заголовок надписи");
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("Заголовок"), "Очистка надписи");
	Элементы.Удалить(Надпись);

КонецПроцедуры

&НаСервере
Процедура ПроверкаКоманда()

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("Заголовок", "Команда");
	Команда = РедакторФорм.НоваяКомандаФормы(Контекст, "РегрессияОтдельнаяКоманда", "Подключаемый_РегрессияКоманда", "По умолчанию");
	ПроверитьУсловиеРегрессии(Команда.Заголовок = "Команда", "Заголовок команды");
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("Заголовок"), "Очистка команды");
	Команды.Удалить(Команда);

КонецПроцедуры

&НаСервере
Процедура ПроверкаКнопкаПанели()

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("Заголовок", "Кнопка панели");
	Кнопка = РедакторФорм.НоваяКомандаИКнопкаКоманднойПанели(Контекст, "РегрессияКомандаПанели", "По умолчанию");
	ПроверитьУсловиеРегрессии(Кнопка.Заголовок = "Кнопка панели", "Заголовок кнопки панели");
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("Заголовок"), "Очистка кнопки панели");
	Элементы.Удалить(Кнопка);
	Команды.Удалить(Команды.РегрессияКомандаПанели);

КонецПроцедуры

&НаСервере
Процедура ПроверкаГиперссылка()

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("Заголовок", "Команда ссылки");
	Ссылка = РедакторФорм.НоваяКомандаИГиперссылкаФормы(Контекст, "РегрессияСсылка", "Подключаемый_РегрессияКоманда", "По умолчанию");
	ПроверитьУсловиеРегрессии(Команды.РегрессияСсылка.Заголовок = "Команда ссылки", "Заголовок команды ссылки");
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("Заголовок"), "Очистка гиперссылки");
	Элементы.Удалить(Ссылка);
	Команды.Удалить(Команды.РегрессияСсылка);

КонецПроцедуры

&НаСервере
Процедура ПроверкаГруппаФормы()

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("Заголовок", "Обычная группа");
	Группа = РедакторФорм.НоваяГруппаФормы(Контекст, "РегрессияГруппаФормы");
	ПроверитьУсловиеРегрессии(Группа.Заголовок = "Обычная группа", "Заголовок группы формы");
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("Заголовок"), "Очистка группы формы");
	Элементы.Удалить(Группа);

КонецПроцедуры

&НаСервере
Процедура ПроверкаГруппаКолонок()

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("Заголовок", "Колонки");
	Группа = РедакторФорм.НоваяГруппаКолонкиЛевоПраво(Контекст, "РегрессияКолонки");
	ПроверитьУсловиеРегрессии(Группа.Заголовок = "Колонки", "Заголовок группы колонок");
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("Заголовок"), "Очистка группы колонок");
	Элементы.Удалить(Элементы.РегрессияКолонкиЛево);
	Элементы.Удалить(Элементы.РегрессияКолонкиПраво);
	Элементы.Удалить(Группа);

