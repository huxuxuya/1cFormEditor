&НаСервере
Процедура ПроверкаОшибкаДубликата()

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Поле = РедакторФорм.НовоеПолеФормы(Контекст, "РегрессияДубликат");
	Контекст.Свойства.Вставить("ПутьКДанным", "Объект.РеквизитСтрока");
	Контекст.Свойства.Вставить("Заголовок", "После ошибки");
	ОшибкаПолучена = Ложь;
	ТекстОшибки = "";
	Попытка
		РедакторФорм.НовоеПолеФормы(Контекст, "РегрессияДубликат");
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ОшибкаПолучена = СтрНайти(ТекстОшибки, "Недопустимое значение параметров") > 0
			И СтрНайти(ТекстОшибки, "Форма.Элементы.Добавить") > 0;
	КонецПопытки;
	ПроверитьУсловиеРегрессии(ОшибкаПолучена, "Ожидалась ошибка повторного имени: " + ТекстОшибки);
	ПроверитьУсловиеРегрессии(Элементы.Найти("РегрессияДубликат") = Поле, "Исходное поле сохранено");
	ПроверитьУсловиеРегрессии(Контекст.Свойства.ПутьКДанным = "Объект.РеквизитСтрока", "Путь сохранен после ошибки");
	ПроверитьУсловиеРегрессии(Контекст.Свойства.Заголовок = "После ошибки", "Заголовок сохранен после ошибки");
	Элементы.Удалить(Поле);

КонецПроцедуры

