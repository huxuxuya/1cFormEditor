&НаСервере
Процедура ПроверкаКонтекстПослеОшибки()

	Для Номер = 1 По 4 Цикл
		ИмяПоля = ?(Номер = 1, "РеквизитДобавитьПолеНаФорму", "РеквизитСтрока");
		Путь = "Объект.РеквизитСтрока";
		Если Номер = 1 Тогда
			Путь = "РеквизитДобавитьПолеНаФорму";
		ИначеЕсли Номер = 3 Тогда
			Путь = "Объект.РеквизитБулево";
		ИначеЕсли Номер = 4 Тогда
			Путь = "Объект.МногострочноеПоле";
		КонецЕсли;
		ИсходноеПоле = Элементы.Добавить(ИмяПоля, Тип("ПолеФормы"));
		Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
		Контекст.Свойства.Вставить("ТолькоПросмотр", Истина);
		Контекст.Свойства.Вставить("Заголовок", "Сохранить после ошибки");
		Контекст.Свойства.Вставить("ПутьКДанным", Путь);
		ОшибкаПолучена = Ложь;
		Попытка
			Если Номер = 1 Тогда
				РедакторФорм.НовоеПолеРеквизитаФормы(Контекст, ИмяПоля);
			ИначеЕсли Номер = 2 Тогда
				РедакторФорм.НовоеПолеФормыРеквизитОбъекта(Контекст, ИмяПоля);
			ИначеЕсли Номер = 3 Тогда
				РедакторФорм.НовоеПолеФлажокФормыРеквизитОбъекта(Контекст, ИмяПоля);
			Иначе
				РедакторФорм.НовоеМногострочноеПолеРеквизитОбъекта(Контекст, ИмяПоля);
			КонецЕсли;
		Исключение
			ОшибкаПолучена = Истина;
		КонецПопытки;
		ПроверитьУсловиеРегрессии(ОшибкаПолучена И Элементы.Найти(ИмяПоля) = ИсходноеПоле, "Дубликат отклонен, исходное поле сохранено: " + Строка(Номер));
		ПроверитьУсловиеРегрессии(Контекст.Свойства.Свойство("ТолькоПросмотр") И Контекст.Свойства.Свойство("Заголовок") И Контекст.Свойства.Свойство("ПутьКДанным"), "После ошибки все исходные свойства сохранены: " + Строка(Номер));
		Элементы.Удалить(ИсходноеПоле);
	КонецЦикла;

	КонтекстКнопки = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	КонтекстКнопки.Свойства.Вставить("Заголовок", "Сохранить при ошибке кнопки");
	КонтекстКнопки.Свойства.Вставить("Подсказка", "Постоянная подсказка");
	Элементы.Добавить("РегрессияКомандаДубликат", Тип("КнопкаФормы"));
	ОшибкаПолучена = Ложь;
	Попытка
		РедакторФорм.НоваяКомандаИКнопкаФормы(КонтекстКнопки, "РегрессияКомандаДубликат", "Явный заголовок");
	Исключение
		ОшибкаПолучена = Истина;
	КонецПопытки;
	ПроверитьУсловиеРегрессии(ОшибкаПолучена И Команды.Найти("РегрессияКомандаДубликат") <> Неопределено, "Команда создана до ошибки дубликата кнопки");
	ПроверитьУсловиеРегрессии(КонтекстКнопки.Свойства.Свойство("Заголовок") И КонтекстКнопки.Свойства.Свойство("Подсказка"), "После ошибки кнопки исходный контекст сохранен");

КонецПроцедуры

&НаСервере
Процедура ПроверкаЯвныеСвойства()

	Для Номер = 1 По 4 Цикл
		Путь = ?(Номер = 1, "РеквизитДобавитьПолеНаФорму", "Объект.РеквизитСтрока");
		Если Номер = 3 Тогда
			Путь = "Объект.РеквизитБулево";
		КонецЕсли;
		Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
		Контекст.Свойства.Вставить("ПутьКДанным", Путь);
		Если Номер = 1 Тогда
			Поле = РедакторФорм.НовоеПолеРеквизитаФормы(Контекст, "ИзоляцияЯвныйПуть");
		ИначеЕсли Номер = 2 Тогда
			Поле = РедакторФорм.НовоеПолеФормыРеквизитОбъекта(Контекст, "ИзоляцияЯвныйПуть");
		ИначеЕсли Номер = 3 Тогда
			Поле = РедакторФорм.НовоеПолеФлажокФормыРеквизитОбъекта(Контекст, "ИзоляцияЯвныйПуть");
		Иначе
			Поле = РедакторФорм.НовоеМногострочноеПолеРеквизитОбъекта(Контекст, "ИзоляцияЯвныйПуть");
		КонецЕсли;
		ПроверитьУсловиеРегрессии(Поле.ПутьКДанным = Путь, "Явный путь имеет приоритет над именем элемента: " + Строка(Номер));
		Элементы.Удалить(Поле);
	КонецЦикла;

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Лево);
	Флажок = РедакторФорм.НовыйРеквизитОбъектаФормы(Контекст, "РеквизитБулево");
	ПроверитьУсловиеРегрессии(Флажок.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево, "Сохранено явное положение заголовка флажка");

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("АвтоМаксимальнаяШирина", Ложь);
	Контекст.Свойства.Вставить("МаксимальнаяШирина", 42);
	Шапка = РедакторФорм.НовоеПолеШапкиФормыРеквизитОбъекта(Контекст, "РеквизитШапки");
	ПроверитьУсловиеРегрессии(Шапка.МаксимальнаяШирина = 42 И Контекст.Свойства.МаксимальнаяШирина = 42, "Сохранена явно заданная ширина поля шапки");

КонецПроцедуры

&НаСервере
Функция ПроверитьКонтекстЭлемента()

	Описание = "НовыйКонтекстЭлемента создаёт независимые defaults и сохраняет явные аргументы/общую структуру свойств";
	Ожидаемое = "defaults=Форма/Неопределено/Неопределено/пустая структура; explicit=форма/родитель/расположение; переданная структура общая; default-структуры независимы";
	Фактическое = "";
	Ошибка = "";
	Попытка
		КонтекстПоУмолчанию = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
		КонтекстИзоляции = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
		СвойстваТест = Новый Структура("Маркер", "исходное");
		РодительТест = Элементы.ФормаКоманднаяПанель;
		КонтекстСАргументами = РедакторФорм.НовыйКонтекстЭлемента(
			ЭтотОбъект, РодительТест, РодительТест, СвойстваТест);

		DefaultsOK = КонтекстПоУмолчанию.Форма = ЭтотОбъект
			И КонтекстПоУмолчанию.Родитель = Неопределено
			И КонтекстПоУмолчанию.РасположитьПередЭлементом = Неопределено
			И ТипЗнч(КонтекстПоУмолчанию.Свойства) = Тип("Структура")
			И КонтекстПоУмолчанию.Свойства.Количество() = 0;
		СвойстваТест.Вставить("Маркер", "из аргумента");
		КонтекстСАргументами.Свойства.Вставить("ДобавленоИзКонтекста", "общая ссылка");
		СсылкаОбщая = КонтекстСАргументами.Свойства.Маркер = "из аргумента"
			И СвойстваТест.Свойство("ДобавленоИзКонтекста");
		ЯвныеАргументыOK = КонтекстСАргументами.Форма = ЭтотОбъект
			И КонтекстСАргументами.Родитель = РодительТест
			И КонтекстСАргументами.РасположитьПередЭлементом = РодительТест;
		КонтекстПоУмолчанию.Свойства.Вставить("ТолькоЭтот", Истина);
		ИзоляцияOK = КонтекстИзоляции.Свойства.Количество() = 0;
		Фактическое = "defaults=" + Строка(DefaultsOK)
			+ "; explicit=" + Строка(ЯвныеАргументыOK)
			+ "; shared-properties=" + Строка(СсылкаОбщая)
			+ "; default-isolation=" + Строка(ИзоляцияOK);
		Если Не DefaultsOK Или Не ЯвныеАргументыOK Или Не СсылкаОбщая Или Не ИзоляцияOK Тогда
			Ошибка = "НовыйКонтекстЭлемента не сохранил ожидаемые значения аргументов или ссылку на Свойства";
		КонецЕсли;
	Исключение
		Ошибка = ОписаниеОшибки();
		Фактическое = "Исключение при проверке контекста: " + Ошибка;
	КонецПопытки;
	Возврат Новый Структура("id,status,description,expected,actual,error",
		"КонтекстЭлемента", ?(ПустаяСтрока(Ошибка), "PASS", "FAIL"), Описание, Ожидаемое, Фактическое, Ошибка);

КонецФункции

&НаСервере
Функция ПроверитьПодготовкуФормы()

	Описание = "ФормаПодготовлена возвращает ложь при первом создании скрытого маркера и истину при повторе";
	Ожидаемое = "first=Ложь; marker=hidden/disabled; second=Истина; marker remains singular";
	Фактическое = "";
	Ошибка = "";
	Маркер = Элементы.Найти("ккФормаПодготовлена");
	Если Маркер <> Неопределено Тогда
		Элементы.Удалить(Маркер);
	КонецЕсли;
	Попытка
		ПервыйВызов = РедакторФорм.ФормаПодготовлена(ЭтотОбъект);
		Маркер = Элементы.Найти("ккФормаПодготовлена");
		ПервыйВызовOK = Не ПервыйВызов И Маркер <> Неопределено
			И Не Маркер.Видимость И Не Маркер.Доступность;
		ВторойВызов = РедакторФорм.ФормаПодготовлена(ЭтотОбъект);
		ВторойВызовOK = ВторойВызов И Элементы.Найти("ккФормаПодготовлена") <> Неопределено;
		Фактическое = "first=" + Строка(ПервыйВызов)
			+ "; marker=" + ?(Маркер <> Неопределено, "present", "missing")
			+ "; hidden=" + Строка(Маркер <> Неопределено И Не Маркер.Видимость)
			+ "; disabled=" + Строка(Маркер <> Неопределено И Не Маркер.Доступность)
			+ "; second=" + Строка(ВторойВызов);
		Если Не ПервыйВызовOK Или Не ВторойВызовOK Тогда
			Ошибка = "Повторная подготовка не сохранила маркер или неверно вернула результат";
		КонецЕсли;
	Исключение
		Ошибка = ОписаниеОшибки();
		Фактическое = "Исключение при проверке подготовки формы: " + Ошибка;
	КонецПопытки;
	Маркер = Элементы.Найти("ккФормаПодготовлена");
	Если Маркер <> Неопределено Тогда
		Элементы.Удалить(Маркер);
	КонецЕсли;
	Возврат Новый Структура("id,status,description,expected,actual,error",
		"ФормаПодготовлена", ?(ПустаяСтрока(Ошибка), "PASS", "FAIL"), Описание, Ожидаемое, Фактическое, Ошибка);

КонецФункции

&НаСервере
Функция ПроверитьРазборСтроки()

	Описание = "РазложитьСтрокуВМассивПодстрок сохраняет пустые сегменты по флагу и контракт пустого ввода";
	Ожидаемое = "default-comma-empty=0; default-space-empty=1 empty item; keep=4 segments including empties; skip=2 nonempty segments";
	Фактическое = "";
	Ошибка = "";
	Попытка
		ПустаяСтрокаЗапятая = РедакторФорм.РазложитьСтрокуВМассивПодстрок("");
		ПустаяСтрокаПробел = РедакторФорм.РазложитьСтрокуВМассивПодстрок("", " ");
		СегментыСохраняются = РедакторФорм.РазложитьСтрокуВМассивПодстрок("a..b.", ".", Ложь);
		ПустыеСегментыПропускаются = РедакторФорм.РазложитьСтрокуВМассивПодстрок("a..b.", ".", Истина);
		EmptyContractOK = ПустаяСтрокаЗапятая.Количество() = 0
			И ПустаяСтрокаПробел.Количество() = 1 И ПустаяСтрокаПробел[0] = "";
		KeepContractOK = СегментыСохраняются.Количество() = 4
			И СегментыСохраняются[0] = "a" И СегментыСохраняются[1] = ""
			И СегментыСохраняются[2] = "b" И СегментыСохраняются[3] = "";
		SkipContractOK = ПустыеСегментыПропускаются.Количество() = 2
			И ПустыеСегментыПропускаются[0] = "a" И ПустыеСегментыПропускаются[1] = "b";
		Фактическое = "default-comma-empty=" + Строка(ПустаяСтрокаЗапятая.Количество())
			+ "; default-space-empty=" + Строка(ПустаяСтрокаПробел.Количество())
			+ "; keep=" + Строка(СегментыСохраняются.Количество())
			+ "; skip=" + Строка(ПустыеСегментыПропускаются.Количество());
		Если Не EmptyContractOK Или Не KeepContractOK Или Не SkipContractOK Тогда
			Ошибка = "Фактические подстроки не соответствуют переданному разделителю/флагу пустых значений";
		КонецЕсли;
	Исключение
		Ошибка = ОписаниеОшибки();
		Фактическое = "Исключение при разборе строки: " + Ошибка;
	КонецПопытки;
	Возврат Новый Структура("id,status,description,expected,actual,error",
		"РазборСтроки", ?(ПустаяСтрока(Ошибка), "PASS", "FAIL"), Описание, Ожидаемое, Фактическое, Ошибка);

КонецФункции

&НаСервере
Процедура ПроверитьУсловиеРегрессии(Условие, Описание)

	Если Не Условие Тогда
		ВызватьИсключение "Ошибка регрессионной проверки: " + Описание;
	КонецЕсли;

КонецПроцедуры

