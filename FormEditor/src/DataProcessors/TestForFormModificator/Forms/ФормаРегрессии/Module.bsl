#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Результаты = Новый Массив;
	ПроверитьОчисткуРазовыхСвойств(Результаты);
	Результаты.Добавить(ПроверитьКонтекстЭлемента());
	Результаты.Добавить(ПроверитьПодготовкуФормы());
	Результаты.Добавить(ПроверитьРазборСтроки());
	Попытка
		ПроверитьИсправленияОткрытыхЗадач();
		Результаты.Добавить(Новый Структура("id,status,description,expected,actual,error",
			"ОбщиеПроверки", "PASS", ОписаниеСценария("ОбщиеПроверки"), "", "", ""));
	Исключение
		ОшибкаПроверки = СтрЗаменить(ОписаниеОшибки(), Символы.ПС, " ");
		Ожидаемое = "Контекст предоставляет обработчики; остальные проверки полей, очистки и элементов проходят";
		Фактическое = "Проверки не завершены: " + ОшибкаПроверки;
		Если СтрНайти(ОшибкаПроверки, "Поле объекта не обнаружено (Обработчики)") > 0 Тогда
			Фактическое = "Проверки полей, очистки, постоянных свойств, команды, группы, таблицы и многострочного поля завершены; свойство Обработчики отсутствует";
		КонецЕсли;
		Результаты.Добавить(Новый Структура("id,status,description,expected,actual,error",
			"ОбщиеПроверки", "FAIL", ОписаниеСценария("ОбщиеПроверки"), Ожидаемое, Фактическое, ОшибкаПроверки));
	КонецПопытки;
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Результаты);
	РезультатыПроверокJSON = ЗаписьJSON.Закрыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Регрессионные проверки #6, #7 и #9 выполняются при открытии тестовой формы.
&НаСервере
Процедура ПроверитьИсправленияОткрытыхЗадач()

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("ПутьКДанным", "Объект.РеквизитСтрока");
	Контекст.Свойства.Вставить("Заголовок", "Разовый заголовок");
	Контекст.Свойства.Вставить("ТолькоПросмотр", Истина);
	ОбработчикиКонтекста = Неопределено;
	ОбработчикиПоддерживаются = Контекст.Свойство("Обработчики", ОбработчикиКонтекста);
	Если ОбработчикиПоддерживаются Тогда
		ОбработчикиКонтекста.Вставить("ПриИзменении", "РегрессияПриИзменении");
	КонецЕсли;
	ПервоеПоле = РедакторФорм.НовоеПолеФормы(Контекст, "РегрессияПервоеПоле");
	ПроверитьУсловиеРегрессии(ПервоеПоле.ПутьКДанным = "Объект.РеквизитСтрока", "Путь первого поля");
	ПроверитьУсловиеРегрессии(ПервоеПоле.Заголовок = "Разовый заголовок", "Заголовок первого поля");
	Если ОбработчикиПоддерживаются Тогда
		ПроверитьУсловиеРегрессии(ПервоеПоле.ПолучитьДействие("ПриИзменении") = "РегрессияПриИзменении", "Обработчик первого поля");
	КонецЕсли;
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("ПутьКДанным"), "Очистка пути");
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("Заголовок"), "Очистка заголовка");
	Если ОбработчикиПоддерживаются Тогда
		ПроверитьУсловиеРегрессии(ОбработчикиКонтекста.Количество() = 0, "Очистка обработчиков");
	КонецЕсли;
	ВтороеПоле = РедакторФорм.НовоеПолеФормыРеквизитОбъекта(Контекст, "РеквизитШапки");
	ПроверитьУсловиеРегрессии(ВтороеПоле.ПутьКДанным = "Объект.РеквизитШапки", "Путь второго поля");
	ПроверитьУсловиеРегрессии(ВтороеПоле.ТолькоПросмотр, "Сохранение общих свойств");
	Если ОбработчикиПоддерживаются Тогда
		ПроверитьУсловиеРегрессии(Не ЗначениеЗаполнено(ВтороеПоле.ПолучитьДействие("ПриИзменении")), "Обработчик не перенесен на второе поле");
	КонецЕсли;

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("ПутьКДанным", "Объект.РеквизитБулево");
	Флажок = РедакторФорм.НовыйРеквизитОбъектаФормы(Контекст, "РегрессияФлажок");
	ПроверитьУсловиеРегрессии(Флажок.Вид = ВидПоляФормы.ПолеФлажка, "Тип по явному пути");
	ПроверитьУсловиеРегрессии(Флажок.Имя = "РеквизитБулево", "Имя элемента соответствует реквизиту явного пути");

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("Заголовок", "Разовый заголовок кнопки");
	Кнопка = РедакторФорм.НоваяКомандаИКнопкаФормы(Контекст, "РегрессияКоманда", "Заголовок по умолчанию");
	ПроверитьУсловиеРегрессии(Кнопка.Заголовок = "Разовый заголовок кнопки", "Заголовок дошел до кнопки");
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("Заголовок"), "Очистка составного вызова");

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("Заголовок", "Разовая группа");
	Группа = РедакторФорм.НоваяГруппаОбычная(Контекст, "РегрессияГруппа");
	ПроверитьУсловиеРегрессии(Группа.Заголовок = "Разовая группа", "Заголовок группы");
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("Заголовок"), "Очистка заголовка группы");

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("Заголовок", "Разовая таблица");
	ОбработчикиТаблицы = Неопределено;
	ОбработчикиТаблицыПоддерживаются = Контекст.Свойство("Обработчики", ОбработчикиТаблицы);
	Если ОбработчикиТаблицыПоддерживаются Тогда
		ОбработчикиТаблицы.Вставить("ПриАктивизацииСтроки", "РегрессияПриАктивизацииСтроки");
	КонецЕсли;
	Колонки = Новый Структура("РегрессияИмяМетода", "ИмяМетода");
	Таблица = РедакторФорм.НоваяТаблицаФормы(Контекст, "РегрессияТаблица", "Объект.ПроверяемыеПроцедурыИФункции", Колонки);
	Если ОбработчикиТаблицыПоддерживаются Тогда
		ПроверитьУсловиеРегрессии(Таблица.ПолучитьДействие("ПриАктивизацииСтроки") = "РегрессияПриАктивизацииСтроки", "Обработчик таблицы");
	КонецЕсли;
	ПроверитьУсловиеРегрессии(Элементы.РегрессияИмяМетода.ПутьКДанным = "Объект.ПроверяемыеПроцедурыИФункции.ИмяМетода", "Путь вложенной колонки");
	Если ОбработчикиТаблицыПоддерживаются Тогда
		ПроверитьУсловиеРегрессии(ОбработчикиТаблицы.Количество() = 0, "Очистка обработчика таблицы");
	КонецЕсли;
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("Заголовок"), "Очистка заголовка таблицы");

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	МногострочноеПоле = РедакторФорм.НовоеМногострочноеПолеРеквизитОбъекта(Контекст, "МногострочноеПоле");
	ПроверитьУсловиеРегрессии(МногострочноеПоле.ПутьКДанным = "Объект.МногострочноеПоле", "Путь многострочного поля");
	ПроверитьУсловиеРегрессии(Не Контекст.Свойства.Свойство("ПутьКДанным"), "Очистка пути многострочного поля");

	Элементы.Удалить(Элементы.РегрессияИмяМетода);
	Элементы.Удалить(Таблица);
	Элементы.Удалить(Группа);
	Элементы.Удалить(МногострочноеПоле);
	Элементы.Удалить(ПервоеПоле);
	Элементы.Удалить(ВтороеПоле);
	Элементы.Удалить(Флажок);
	Элементы.Удалить(Кнопка);
	Команды.Удалить(Команды.РегрессияКоманда);

	Если Не ОбработчикиПоддерживаются Или Не ОбработчикиТаблицыПоддерживаются Тогда
		ВызватьИсключение "Поле объекта не обнаружено (Обработчики)";
	КонецЕсли;

КонецПроцедуры

// Сценарии выполняются независимо; все ошибки собираются до завершения набора.
&НаСервере
Процедура ПроверитьОчисткуРазовыхСвойств(Результаты)

	ВыполнитьПроверкуОчистки(1, "ГруппаКнопок", "ГруппаКнопокФормы0,РегрессияПанель", "", Результаты);
	ВыполнитьПроверкуОчистки(2, "Надпись", "РегрессияНадпись", "", Результаты);
	ВыполнитьПроверкуОчистки(3, "Команда", "", "РегрессияОтдельнаяКоманда", Результаты);
	ВыполнитьПроверкуОчистки(4, "КнопкаПанели", "РегрессияКомандаПанели", "РегрессияКомандаПанели", Результаты);
	ВыполнитьПроверкуОчистки(5, "Гиперссылка", "РегрессияСсылка", "РегрессияСсылка", Результаты);
	ВыполнитьПроверкуОчистки(6, "ГруппаФормы", "РегрессияГруппаФормы", "", Результаты);
	ВыполнитьПроверкуОчистки(7, "ГруппаКолонок", "РегрессияКолонкиЛево,РегрессияКолонкиПраво,РегрессияКолонки", "", Результаты);
	ВыполнитьПроверкуОчистки(8, "ПолеРеквизитаФормы", "РеквизитДобавитьПолеНаФорму", "", Результаты);
	ВыполнитьПроверкуОчистки(9, "ПолеШапки", "РеквизитШапки", "", Результаты);
	ВыполнитьПроверкуОчистки(10, "Флажок", "РеквизитБулево", "", Результаты);
	ВыполнитьПроверкуОчистки(11, "ОшибкаДубликата", "РегрессияДубликат", "", Результаты);
	ВыполнитьПроверкуОчистки(12, "ДинамическийСписок", "", "", Результаты);
	ВыполнитьПроверкуОчистки(13, "КонтекстПослеГруппы", "ИзоляцияПоле,ИзоляцияКолонкиЛево,ИзоляцияКолонкиПраво,ИзоляцияКолонки", "", Результаты);
	ВыполнитьПроверкуОчистки(14, "КонтекстПослеФлажка", "РеквизитБулево,РеквизитСтрока", "", Результаты);
	ВыполнитьПроверкуОчистки(15, "КонтекстПослеШапки", "РеквизитШапки,РеквизитСтрока", "", Результаты);
	ВыполнитьПроверкуОчистки(16, "КонтекстПослеМногострочногоПоля", "МногострочноеПоле,РеквизитСтрока", "", Результаты);
	ВыполнитьПроверкуОчистки(17, "КонтекстПослеОшибки", "РеквизитСтрока,РеквизитДобавитьПолеНаФорму,РегрессияКомандаДубликат", "РегрессияКомандаДубликат", Результаты);
	ВыполнитьПроверкуОчистки(18, "ЯвныеСвойства", "ИзоляцияЯвныйПуть,РеквизитБулево,РеквизитШапки", "", Результаты);


КонецПроцедуры

&НаСервере
Процедура ВыполнитьПроверкуОчистки(Номер, Имя, ИменаЭлементов, ИменаКоманд, Результаты)

	Ошибка = "";
	Попытка
		Если Номер = 1 Тогда
			ПроверкаГруппаКнопок();
		ИначеЕсли Номер = 2 Тогда
			ПроверкаНадпись();
		ИначеЕсли Номер = 3 Тогда
			ПроверкаКоманда();
		ИначеЕсли Номер = 4 Тогда
			ПроверкаКнопкаПанели();
		ИначеЕсли Номер = 5 Тогда
			ПроверкаГиперссылка();
		ИначеЕсли Номер = 6 Тогда
			ПроверкаГруппаФормы();
		ИначеЕсли Номер = 7 Тогда
			ПроверкаГруппаКолонок();
		ИначеЕсли Номер = 8 Тогда
			ПроверкаПолеРеквизитаФормы();
		ИначеЕсли Номер = 9 Тогда
			ПроверкаПолеШапки();
		ИначеЕсли Номер = 10 Тогда
			ПроверкаФлажок();
		ИначеЕсли Номер = 11 Тогда
			ПроверкаОшибкаДубликата();
		ИначеЕсли Номер = 12 Тогда
			ПроверкаДинамическийСписок();
		ИначеЕсли Номер = 13 Тогда
			ПроверкаКонтекстПослеГруппы();
		ИначеЕсли Номер = 14 Тогда
			ПроверкаКонтекстПослеФлажка();
		ИначеЕсли Номер = 15 Тогда
			ПроверкаКонтекстПослеШапки();
		ИначеЕсли Номер = 16 Тогда
			ПроверкаКонтекстПослеМногострочногоПоля();
		ИначеЕсли Номер = 17 Тогда
			ПроверкаКонтекстПослеОшибки();
		ИначеЕсли Номер = 18 Тогда
			ПроверкаЯвныеСвойства();
		КонецЕсли;
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Попытка
		Для Каждого ИмяЭлемента Из СтрРазделить(ИменаЭлементов, ",", Ложь) Цикл
			Элемент = Элементы.Найти(ИмяЭлемента);
			Если Элемент <> Неопределено Тогда
				Элементы.Удалить(Элемент);
			КонецЕсли;
		КонецЦикла;
		Если Номер = 12 Тогда
			УдаляемыеРеквизиты = Новый Массив;
			УдаляемыеРеквизиты.Добавить("РегрессияДинамическийСписок");
			ИзменитьРеквизиты(Новый Массив, УдаляемыеРеквизиты);
		КонецЕсли;
		Для Каждого ИмяКоманды Из СтрРазделить(ИменаКоманд, ",", Ложь) Цикл
			Команда = Команды.Найти(ИмяКоманды);
			Если Команда <> Неопределено Тогда
				Команды.Удалить(Команда);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Ошибка = Ошибка + " Ошибка очистки: " + ОписаниеОшибки();
	КонецПопытки;

	Статус = ?(ЗначениеЗаполнено(Ошибка), "FAIL", "PASS");
	Результаты.Добавить(Новый Структура("id,status,description,expected,actual,error",
		Имя, Статус, ОписаниеСценария(Имя), "", "", СтрЗаменить(Ошибка, Символы.ПС, " ")));

КонецПроцедуры

&НаСервере
Функция ОписаниеСценария(Имя)
	Описания = Новый Структура;
	Описания.Вставить("ОбщиеПроверки", "Общие проверки контекста, обработчиков и создаваемых элементов");
	Описания.Вставить("ГруппаКнопок", "Вид группы кнопок и очистка одноразовых свойств; заголовок не применяется к этому виду группы");
	Описания.Вставить("Надпись", "Заголовок надписи и очистка одноразовых свойств");
	Описания.Вставить("Команда", "Заголовок команды и очистка одноразовых свойств");
	Описания.Вставить("КнопкаПанели", "Кнопка командной панели и очистка одноразовых свойств");
	Описания.Вставить("Гиперссылка", "Гиперссылка и команда; проверка заголовка");
	Описания.Вставить("ГруппаФормы", "Обычная группа и очистка одноразовых свойств");
	Описания.Вставить("ГруппаКолонок", "Группа колонок и очистка одноразовых свойств");
	Описания.Вставить("ПолеРеквизитаФормы", "Поле реквизита формы и очистка заголовка и пути");
	Описания.Вставить("ПолеШапки", "Поле шапки объектного реквизита и очистка одноразовых свойств");
	Описания.Вставить("Флажок", "Поле булевого реквизита и очистка одноразовых свойств");
	Описания.Вставить("ОшибкаДубликата", "Повторное имя отклонено, контекст сохранен");
	Описания.Вставить("ДинамическийСписок", "Создание динамического списка и очистка контекста");
	Описания.Вставить("КонтекстПослеГруппы", "Следующий элемент не наследует внутренние свойства группы");
	Описания.Вставить("КонтекстПослеФлажка", "Постоянные свойства сохраняются после создания флажка");
	Описания.Вставить("КонтекстПослеШапки", "Следующее поле получает собственный путь после поля шапки");
	Описания.Вставить("КонтекстПослеМногострочногоПоля", "Путь многострочного поля не переносится на следующее");
	Описания.Вставить("КонтекстПослеОшибки", "Одноразовые свойства сохраняются после ошибок поля и составной кнопки");
	Описания.Вставить("ЯвныеСвойства", "Явные пути и пользовательские настройки имеют приоритет");
	Возврат Описания[Имя];
КонецФункции

&НаСервере
Процедура ПроверкаГруппаКнопок()

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Панель = Элементы.Добавить("РегрессияПанель", Тип("ГруппаФормы"));
	Панель.Вид = ВидГруппыФормы.КоманднаяПанель;
	Контекст.Родитель = Панель;
	Контекст.Свойства.Вставить("Заголовок", "Не применяется к группе кнопок");
	Контекст.Свойства.Вставить("ПутьКДанным", "Не применяется к группе кнопок");
