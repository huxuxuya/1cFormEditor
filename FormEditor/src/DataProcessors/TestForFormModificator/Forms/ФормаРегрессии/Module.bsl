	ПроверитьУсловиеРегрессии(Элементы.ИзоляцияКолонкиЛево.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная, "Вертикальная группировка вложенной колонки");
	ПроверитьУсловиеРегрессии(Поле.Вид = ВидПоляФормы.ПолеВвода, "После группы создано обычное поле");
	ПроверитьУсловиеРегрессии(Контекст.Свойства.Количество() = 0, "Группа не добавляет свойства в контекст");

КонецПроцедуры

&НаСервере
Процедура ПроверкаКонтекстПослеФлажка()

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Контекст.Свойства.Вставить("ТолькоПросмотр", Истина);
	Флажок = РедакторФорм.НовыйРеквизитОбъектаФормы(Контекст, "РеквизитБулево");
	Поле = РедакторФорм.НовоеПолеФормыРеквизитОбъекта(Контекст, "РеквизитСтрока");
	ПроверитьУсловиеРегрессии(Флажок.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право, "Заголовок флажка справа");
	ПроверитьУсловиеРегрессии(Поле.ПутьКДанным = "Объект.РеквизитСтрока" И Поле.ТолькоПросмотр, "Следующее поле сохраняет пользовательские настройки и свой путь");
	ПроверитьУсловиеРегрессии(Контекст.Свойства.Количество() = 1 И Контекст.Свойства.ТолькоПросмотр, "Флажок не добавляет свойства в контекст");

КонецПроцедуры

&НаСервере
Процедура ПроверкаКонтекстПослеШапки()

	Контекст = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
	Шапка = РедакторФорм.НовоеПолеШапкиФормыРеквизитОбъекта(Контекст, "РеквизитШапки");
	Поле = РедакторФорм.НовоеПолеФормыРеквизитОбъекта(Контекст, "РеквизитСтрока");
	ПроверитьУсловиеРегрессии(Шапка.МаксимальнаяШирина = 28 И Не Шапка.АвтоМаксимальнаяШирина, "Ширина поля шапки ограничена");
	ПроверитьУсловиеРегрессии(Поле.ПутьКДанным = "Объект.РеквизитСтрока", "Путь следующего поля после шапки");
	ПроверитьУсловиеРегрессии(Контекст.Свойства.Количество() = 0, "Поле шапки не добавляет свойства в контекст");

