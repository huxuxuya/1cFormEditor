#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Отчёт создаётся средствами платформы, независимо от проверяемого модуля.
	Итог = Элементы.Добавить("ИтогАвтотестов", Тип("ДекорацияФормы"));
	Итог.Заголовок = "Автотесты ещё не запущены";
	ПолеОтчета = Элементы.Добавить("ПротоколАвтотестов", Тип("ПолеФормы"));
	ПолеОтчета.ПутьКДанным = "ПротоколАвтотестов";
	ПолеОтчета.Вид = ВидПоляФормы.ПолеВвода;
	ПолеОтчета.МногострочныйРежим = Истина;
	ПолеОтчета.ТолькоПросмотр = Истина;
	ПолеОтчета.АвтоМаксимальнаяШирина = Ложь;
	ПолеОтчета.Ширина = 150;
	ПолеОтчета.Высота = 17;
	ПолеОтчета.Заголовок = "Проверка | название | что проверено и фактический результат";
	КомандаПовтора = Команды.Добавить("ПовторитьАвтотесты");
	КомандаПовтора.Действие = "ВыполнитьАвтотесты";
	КомандаПовтора.Заголовок = "Повторить автотесты";
	КнопкаПовтора = Элементы.Добавить("ПовторитьАвтотесты", Тип("КнопкаФормы"));
	КнопкаПовтора.ИмяКоманды = "ПовторитьАвтотесты";
	Попытка
		СоздатьДемонстрационныеЭлементы();
	Исключение
		ОшибкаПодготовки = ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВыполнитьАвтотесты();
КонецПроцедуры

// Единственная точка запуска для ручной проверки и контейнерного прогона.
&НаКлиенте
Процедура ВыполнитьАвтотесты(Команда = Неопределено) Экспорт

	Результаты = Новый Массив;
	Попытка
		Результаты = ПроверитьДемонстрациюНаСервере();
	Исключение
		Результаты.Добавить("FAIL | ПроверкаДемонстрации | Создание и проверка демонстрационных элементов; ошибка: " + ПонятнаяДиагностика(ОписаниеОшибки()));
	КонецПопытки;
	Для Каждого ИмяПроверяемойФормы Из СтрРазделить("ФормаРегрессии,ФормаПереименованная,ФормаНеоднозначная", ",") Цикл
		ФормаПроверки = Неопределено;
		Попытка
			// Новый ключ исключает повторное использование состояния прошлой проверки.
			ФормаПроверки = ПолучитьФорму("Обработка.TestForFormModificator.Форма." + ИмяПроверяемойФормы, , , Новый УникальныйИдентификатор);
			Если ИмяПроверяемойФормы = "ФормаРегрессии" Тогда
				Если Не ЗначениеЗаполнено(ФормаПроверки.РезультатыПроверок) Тогда
					ВызватьИсключение "Нет результатов регрессионных проверок";
				КонецЕсли;
				Для Каждого СтрокаРезультата Из СтрРазделить(ФормаПроверки.РезультатыПроверок, Символы.ПС, Ложь) Цикл
					Результаты.Добавить(ОформитьРезультатСценария(СтрокаРезультата));
				КонецЦикла;
			Иначе
				Результаты.Добавить("PASS | " + ИмяПроверяемойФормы + " | " + ОписаниеПроверки(ИмяПроверяемойФормы) + "; все условия сценария выполнены.");
			КонецЕсли;
		Исключение
			Результаты.Добавить("FAIL | " + ИмяПроверяемойФормы + " | " + ОписаниеПроверки(ИмяПроверяемойФормы) + "; ошибка: " + ПонятнаяДиагностика(ОписаниеОшибки()));
		КонецПопытки;
		// Формы-проверки не открываются пользователю. Освобождаем ссылку.
		ФормаПроверки = Неопределено;
	КонецЦикла;
	Ошибок = 0;
	Для Каждого Результат Из Результаты Цикл
		Если Лев(Результат, 7) <> "PASS | " Тогда
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;
	Если Ошибок = 0 И Результаты.Количество() > 0 Тогда
		Элементы.ИтогАвтотестов.Заголовок = "Все проверки пройдены: " + Результаты.Количество() + " из " + Результаты.Количество();
	Иначе
		Элементы.ИтогАвтотестов.Заголовок = "Проверки: " + (Результаты.Количество() - Ошибок) + " из " + Результаты.Количество() + " пройдены; ошибок " + Ошибок;
	КонецЕсли;
	ПротоколАвтотестов = "Статус | Проверка | Что проверено и фактический результат" + Символы.ПС + СтрСоединить(Результаты, Символы.ПС);

КонецПроцедуры

&НаСервере
Функция ПроверитьДемонстрациюНаСервере()

	Результаты = Новый Массив;
	Если ЗначениеЗаполнено(ОшибкаПодготовки) Тогда
		Результаты.Добавить("FAIL | СозданиеДемонстрации | Создание демонстрационных элементов; ошибка: " + СтрЗаменить(ОшибкаПодготовки, Символы.ПС, " "));
		Возврат Результаты;
	КонецЕсли;
	ДобавитьРезультатПроверки(Результаты, "СозданиеДемонстрации", Истина,
		"Вызов создания демонстрационной формы и тестовых элементов", "завершился без исключения", "без исключения");
	ФактическийПуть = Элементы.РеквизитСтрока.ПутьКДанным;
	ДобавитьРезультатПроверки(Результаты, "ПривязкаПоля", ФактическийПуть = "Объект.РеквизитСтрока",
		"ПутьКДанным поля РеквизитСтрока", ФактическийПуть, "Объект.РеквизитСтрока");
	ФактическийВид = Строка(Элементы.Флажок.Вид);
	ДобавитьРезультатПроверки(Результаты, "ВидФлажка", Элементы.Флажок.Вид = ВидПоляФормы.ПолеФлажка,
		"Вид элемента Флажок", ФактическийВид, "Поле флажка");
	ФактическоеКоличество = Элементы.РеквизитСтрока.СписокВыбора.Количество();
	ДобавитьРезультатПроверки(Результаты, "СписокВыбора", ФактическоеКоличество = 2,
		"Количество вариантов списка у поля РеквизитСтрока", Строка(ФактическоеКоличество), "2");
	ФактическоеДействие = Команды.Подключаемый_КомандаКнопки1.Действие;
	ДобавитьРезультатПроверки(Результаты, "ДействиеКоманды", ФактическоеДействие = "Подключаемый_КомандаКнопки1",
		"Действие команды Подключаемый_КомандаКнопки1", ФактическоеДействие, "Подключаемый_КомандаКнопки1");
	Возврат Результаты;

КонецФункции

&НаСервере
Процедура ДобавитьРезультатПроверки(Результаты, Имя, Условие, ЧтоПроверяется, ФактическийРезультат, ОжидаемыйРезультат)
	Статус = ?(Условие, "PASS | ", "FAIL | ");
	Результаты.Добавить(Статус + Имя + " | " + ЧтоПроверяется
		+ "; фактически: «" + ФактическийРезультат + "»; ожидалось: «" + ОжидаемыйРезультат + "».");
КонецПроцедуры

&НаКлиенте
Функция ОформитьРезультатСценария(СтрокаРезультата)

	Успешно = Лев(СтрокаРезультата, 5) = "PASS ";
	Текст = Сред(СтрокаРезультата, 6);
	ПозицияРазделителя = СтрНайти(Текст, ":");
	Если Успешно Или ПозицияРазделителя = 0 Тогда
		Имя = Текст;
		Диагностика = "";
	Иначе
		Имя = Лев(Текст, ПозицияРазделителя - 1);
		Диагностика = СокрЛП(Сред(Текст, ПозицияРазделителя + 1));
	КонецЕсли;

	Если Успешно Тогда
		Возврат "PASS | " + Имя + " | " + ОписаниеПроверки(Имя) + "; все условия сценария выполнены.";
	КонецЕсли;
	Возврат "FAIL | " + Имя + " | " + ОписаниеПроверки(Имя) + "; ошибка: " + ПонятнаяДиагностика(Диагностика);

КонецФункции

&НаКлиенте
Функция ПонятнаяДиагностика(ТекстОшибки)

	МаркерПроверки = "Ошибка регрессионной проверки: ";
	ПозицияМаркера = СтрНайти(ТекстОшибки, МаркерПроверки);
	Если ПозицияМаркера > 0 Тогда
		Возврат "не пройдено условие «" + СокрЛП(Сред(ТекстОшибки, ПозицияМаркера + СтрДлина(МаркерПроверки))) + "»";
	КонецЕсли;

	ПозицияПути = СтрНайти(ТекстОшибки, "}: ");
	Если ПозицияПути > 0 Тогда
		ТекстОшибки = Сред(ТекстОшибки, ПозицияПути + 3);
	КонецЕсли;
	Возврат СтрЗаменить(ТекстОшибки, Символы.ПС, " ");

КонецФункции

&НаКлиенте
Функция ОписаниеПроверки(Имя)

	Описания = Новый Структура;
	Описания.Вставить("СозданиеДемонстрации", "создание демонстрационной формы и элементов");
	Описания.Вставить("ПривязкаПоля", "путь поля РеквизитСтрока должен вести к реквизиту объекта");
	Описания.Вставить("ВидФлажка", "тип элемента для булевого реквизита должен быть ПолеФлажка");
	Описания.Вставить("СписокВыбора", "у поля должны быть два варианта списка выбора");
	Описания.Вставить("ДействиеКоманды", "у команды должно быть назначено действие с ее именем");
	Описания.Вставить("ОбщиеПроверки", "путь, заголовок и обработчик первого поля; очистка одноразовых свойств; сохранение ТолькоПросмотр; отсутствие переноса обработчика на следующее поле; определение флажка по явному пути; создание команды, группы, таблицы и многострочного поля с корректными путями и обработчиками");
	Описания.Вставить("ГруппаКнопок", "создание группы кнопок внутри командной панели; заголовок применен, одноразовое свойство удалено из контекста");
	Описания.Вставить("Надпись", "создание надписи; заголовок применен, одноразовое свойство удалено из контекста");
	Описания.Вставить("Команда", "создание команды; заголовок из контекста имеет приоритет, свойство удалено после вызова");
	Описания.Вставить("КнопкаПанели", "создание кнопки командной панели; заголовок применен, свойство удалено после вызова");
	Описания.Вставить("Гиперссылка", "создание гиперссылки и команды; заголовок команды взят из контекста, свойство удалено");
	Описания.Вставить("ГруппаФормы", "создание обычной группы; заголовок применен, одноразовое свойство удалено из контекста");
	Описания.Вставить("ГруппаКолонок", "создание группы колонок; заголовок применен, одноразовое свойство удалено из контекста");
	Описания.Вставить("ПолеРеквизитаФормы", "создание поля реквизита формы; заголовок применен, заголовок и путь удалены из контекста");
	Описания.Вставить("ПолеШапки", "создание поля шапки объектного реквизита; заголовок применен, заголовок и путь удалены из контекста");
	Описания.Вставить("Флажок", "создание поля булевого реквизита; заголовок применен, заголовок и путь удалены из контекста");
	Описания.Вставить("ОшибкаДубликата", "повторное имя отклонено; исходное поле и свойства контекста сохранились после ошибки");
	Описания.Вставить("ДинамическийСписок", "создание динамического списка и очистка заголовка и пути из контекста; запрос и данные списка не проверяются");
	Описания.Вставить("ФормаПереименованная", "поиск реквизита объекта по фактическому имени атрибута формы; вид флажка и отсутствие переноса пути на следующее поле");
	Описания.Вставить("ФормаНеоднозначная", "обнаружение неоднозначности двух реквизитов; выбор ВторойОбъект, вид флажка и отсутствие переноса пути");

	Описания.Вставить("КонтекстПослеГруппы", "группа колонок и следующее поле создаются; внутренние свойства группы не попадают в контекст");
	Описания.Вставить("КонтекстПослеФлажка", "после флажка создается строковое поле; ТолькоПросмотр сохраняется, положение заголовка не попадает в контекст");
	Описания.Вставить("КонтекстПослеШапки", "поле шапки имеет ширину 28; ограничения ширины не попадают в контекст");
	Описания.Вставить("КонтекстПослеМногострочногоПоля", "многострочное и обычное поля получают свои пути; вычисленный путь не попадает в контекст");
	Описания.Вставить("КонтекстПослеОшибки", "четыре функции создания полей при повторном имени сохраняют исходный элемент и пользовательский контекст");

	Описания.Вставить("ЯвныеСвойства", "четыре функции используют явный путь; пользовательские положение заголовка и ширина сохраняют приоритет");

	Описание = Неопределено;
	Если Описания.Свойство(Имя, Описание) Тогда
		Возврат Описание;
	КонецЕсли;
	Возврат "выполнение сценария " + Имя;

КонецФункции

&НаСервере
Процедура СоздатьДемонстрационныеЭлементы()

	НаполнитьТаблицуПроверкиМетодовМетодами();

	#Область ДобавлениеСтраниц
	
	КонтекстСтраницы = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект, , , Новый Структура("Вид", ВидГруппыФормы.Страницы));
	ГруппаСтраницы = РедакторФорм.НоваяГруппаФормы(КонтекстСтраницы, "ГруппаСтраницы");
	КонтекстСтраницы.Родитель = ГруппаСтраницы;
	КонтекстСтраницы.Свойства.Вид = ВидГруппыФормы.Страница;	
	
	КонтекстСтраницы.Свойства.Вставить("Заголовок", "Основная");
	ГруппаПерваяСтраница = РедакторФорм.НоваяГруппаФормы(КонтекстСтраницы, "ПерваяСтраница");	
	КонтекстСтраницы.Свойства.Вставить("Заголовок", "Итоговая таблица");
	ГруппаВтораяСтраница = РедакторФорм.НоваяГруппаФормы(КонтекстСтраницы, "ВтораяСтраница");
	
	#КонецОбласти
	
	#Область ДобавлениеГрупп
	
	КонтекстФормы = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект, ГруппаПерваяСтраница);
	РедакторФорм.НоваяГруппаКолонкиЛевоПраво(КонтекстФормы, "ГруппаСтроковыхРеквизитов");
	ГруппаСтроковыхРеквизитовЛево = Элементы.ГруппаСтроковыхРеквизитовЛево;
	
	КонтекстФормы = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект, ГруппаСтроковыхРеквизитовЛево);
	РедакторФорм.НоваяГруппаКолонкиЛевоПраво(КонтекстФормы, "ЛеваяПодгруппа");
	ЛеваяПодгруппаЛево = Элементы.ЛеваяПодгруппаЛево;
	ЛеваяПодгруппаПраво = Элементы.ЛеваяПодгруппаПраво;
	
	// Вторая страница
	КонтекстФормы = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект, ГруппаВтораяСтраница, , Новый Структура("Группировка", ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда));
	ГруппаИтоговойТаблицы = РедакторФорм.НоваяГруппаОбычная(КонтекстФормы, "ГруппаИтоговойТаблицы");
	ГруппаРеквизитовИтогов = РедакторФорм.НоваяГруппаОбычная(КонтекстФормы, "ГруппаРеквизитовИтогов");
	
	// Первая страница
	КонтекстФормы = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект, ГруппаПерваяСтраница);
	ГруппаМногострочноеПоле = РедакторФорм.НоваяГруппаОбычная(КонтекстФормы, "ГруппаМногострочноеПоле");

	КонтекстФормы.Свойства.Вставить("Вид", ВидГруппыФормы.ОбычнаяГруппа);
	КонтекстФормы.Свойства.Вставить("Группировка", ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно);
	КонтекстФормы.Свойства.Вставить("ОтображатьЗаголовок", Ложь);							
	ГруппаБулево = РедакторФорм.НоваяГруппаФормы(КонтекстФормы, "ГруппаБулево"); 
	
	ДобавитьКСчетчикуПоМетоду("НоваяГруппаКолонкиЛевоПраво", 1);
	ДобавитьКСчетчикуПоМетоду("НоваяГруппаФормы", 1);

	ЛеваяПодгруппаЛево.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	#КонецОбласти
	
	#Область СтраницаОсновная
	
	КонтекстКоманда2 = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект, ЛеваяПодгруппаПраво);
	РедакторФорм.НоваяКомандаИГиперссылкаФормы(КонтекстКоманда2, "КомандаКнопки2", "Подключаемый_КомандаКнопки2", "Очистить все");
	ДобавитьКСчетчикуПоМетоду("НоваяКомандаИГиперссылкаФормы", 1);

	КонтекстФормы = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект, ГруппаМногострочноеПоле);
