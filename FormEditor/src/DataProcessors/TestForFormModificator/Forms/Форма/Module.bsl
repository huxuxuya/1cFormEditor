&НаКлиенте
Функция СнятьСнимокПровалаUITest(Идентификатор, КаталогСнимков, ПутьКСкрипту, ИДПроцессаTestClient)

	ОтносительныйПуть = "screenshots/" + Идентификатор + ".png";
	ПутьКСнимку = КаталогСнимков + "/" + Идентификатор + ".png";
	ОшибкаСнимка = "";
	Попытка
		Кавычка = Символ(34);
		КомандаСнимка = "timeout 10s python3 " + Кавычка + ПутьКСкрипту + Кавычка
			+ " --client-pid " + Формат(ИДПроцессаTestClient, "ЧГ=0")
			+ " --output-dir " + Кавычка + КаталогСнимков + Кавычка
			+ " --scenario-id " + Идентификатор;
		КодВозвратаСнимка = 1;
		ЗапуститьПриложение(КомандаСнимка, "/project", Истина, КодВозвратаСнимка);
		ФайлСнимка = Новый Файл(ПутьКСнимку);
		Если КодВозвратаСнимка = 0 И ФайлСнимка.Существует() Тогда
			Возврат Новый Структура("screenshot,screenshot_error", ОтносительныйПуть, "");
		КонецЕсли;
		ОшибкаСнимка = "Capture helper exit=" + Формат(КодВозвратаСнимка, "ЧГ=0");
	Исключение
		ОшибкаСнимка = ПонятнаяДиагностика(ОписаниеОшибки());
	КонецПопытки;

	Возврат Новый Структура("screenshot,screenshot_error", "", ОшибкаСнимка);

КонецФункции

&НаКлиенте
Функция ВыполнитьПроверкуTestClient(ПортUITest, КаталогСнимковUITest,
	ПутьКСкриптуСнимкаUITest, ИДПроцессаTestClient) Экспорт

#Если ТолстыйКлиентУправляемоеПриложение Тогда
	// Тип тестируемого приложения доступен только в режиме менеджера;
	// вычисление строки не ломает компиляцию той же формы в обычном клиенте.
	ТестКлиент = Вычислить("Новый ТестируемоеПриложение(""127.0.0.1"", " + Формат(ПортUITest, "ЧГ=0") + ")");
	Для НомерПопытки = 1 По 60 Цикл
		Попытка
			ТестКлиент.УстановитьСоединение();
			Прервать;
		Исключение
			Если НомерПопытки = 60 Тогда
				ВызватьИсключение "TestClient не подключился: " + ОписаниеОшибки();
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	Если Не ТестКлиент.ОжидатьОтображениеОбъекта(Тип("ТестируемаяФорма"), "Test for form modificator*", , 120) Тогда
		ВызватьИсключение "TestClient не открыл основную форму стенда за 120 секунд";
	КонецЕсли;
	ОсновнаяФормаТестКлиента = ТестКлиент.НайтиОбъект(Тип("ТестируемаяФорма"), "Test for form modificator*");
	ФормаТестКлиента = ОсновнаяФормаТестКлиента;
	КнопкаОткрытияСтенда = ОсновнаяФормаТестКлиента.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Открыть UI стенд", , 10);
	Если КнопкаОткрытияСтенда = Неопределено Тогда
		ВызватьИсключение "TestClient object not found: type=ТестируемаяКнопкаФормы, title=Открыть UI стенд";
	КонецЕсли;
	КнопкаОткрытияСтенда.Нажать();
	Если Не ТестКлиент.ОжидатьОтображениеОбъекта(Тип("ТестируемоеПолеФормы"), "UI_TEST_INPUT", , 30) Тогда
		ПолеПротоколаUITest = ОсновнаяФормаТестКлиента.НайтиОбъект(Тип("ТестируемоеПолеФормы"), "Статус | ID | проверка*");
		ДиагностикаПодготовкиUITest = "";
		Если ПолеПротоколаUITest <> Неопределено Тогда
			ДиагностикаПодготовкиUITest = ПолеПротоколаUITest.ПолучитьПредставлениеДанных();
		КонецЕсли;
		ВызватьИсключение "TestClient не создал динамическое поле UI_TEST_INPUT за 30 секунд. UI setup: " + ДиагностикаПодготовкиUITest;
	КонецЕсли;
	РезультатыUITest = Новый Массив;
	ИдентификаторыUITest = СтрРазделить("UI_FieldInput_ButtonClick,UI_DirectButtonClick,UI_CommandPanelButtonClick,UI_HyperlinkClick,UI_FormBoundFieldInput,UI_ObjectBoundFieldInput,UI_HeaderFieldInput,UI_MultilineFieldInput,UI_CheckboxToggle,UI_ObjectRequisiteCheckbox,UI_GroupVisibility,UI_DecorationVisible,UI_TableFieldRead,UI_DynamicListRead", ",");
	Для Каждого ИдентификаторUITest Из ИдентификаторыUITest Цикл
		РезультатыUITest.Добавить(ВыполнитьСценарийTestClient(ТестКлиент, ФормаТестКлиента,
			ИдентификаторUITest, КаталогСнимковUITest, ПутьКСкриптуСнимкаUITest, ИДПроцессаTestClient));
	КонецЦикла;
	ПроваленоUITest = 0;
	Для Каждого РезультатUITest Из РезультатыUITest Цикл
		Если РезультатUITest.status <> "PASS" Тогда
			ПроваленоUITest = ПроваленоUITest + 1;
		КонецЕсли;
	КонецЦикла;
	СтатусUITest = ?(ПроваленоUITest = 0, "PASS", "FAIL");
	ОтчетUITest = Новый Структура;
	ОтчетUITest.Вставить("schema_version", 1);
	ОтчетUITest.Вставить("suite", "FormEditor UI");
	ОтчетUITest.Вставить("status", СтатусUITest);
	ОтчетUITest.Вставить("results", РезультатыUITest);
	ОтчетUITest.Вставить("totals", Новый Структура("total,passed,failed", РезультатыUITest.Количество(), РезультатыUITest.Количество() - ПроваленоUITest, ПроваленоUITest));
	ЗаписьJSONUITest = Новый ЗаписьJSON;
	ЗаписьJSONUITest.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSONUITest, ОтчетUITest);
	Возврат ЗаписьJSONUITest.Закрыть();
#Иначе
	ВызватьИсключение "Автоматизированная UI-проверка поддерживается только в толстом клиенте /TESTMANAGER";
#КонецЕсли

КонецФункции

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьИтогУспешных()
	
	Объект.ВсегоУспешных = Объект.ПроверяемыеПроцедурыИФункции.Итог("Проверено");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКСчетчикуПоМетоду(ИмяМетода, Вызвано = 0, Проверено = 0)

	СтруктураПоиска = Новый Структура("ИмяМетода", ИмяМетода);
	СтрокиМетода = Объект.ПроверяемыеПроцедурыИФункции.НайтиСтроки(СтруктураПоиска);
	Для каждого СтрокаМетода Из СтрокиМетода Цикл
		СтрокаМетода.Вызвано = СтрокаМетода.Вызвано + Вызвано;
		СтрокаМетода.Проверено = СтрокаМетода.Проверено + Проверено;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура НаполнитьТаблицуПроверкиМетодовМетодами()
	
	МассивИменМетодов = Новый Массив;
	
	// ДобавлениеПолей
	МассивИменМетодов.Добавить("НовоеПолеФормы");
	МассивИменМетодов.Добавить("НовоеПолеРеквизитаФормы");
	
	// ДобавлениеГрупп
	МассивИменМетодов.Добавить("НоваяГруппаФормы");
	МассивИменМетодов.Добавить("НоваяГруппаКолонкиЛевоПраво");

	// ДобавлениеТаблиц
	МассивИменМетодов.Добавить("НоваяТаблицаФормы");
	МассивИменМетодов.Добавить("НовоеПолеТабличнойЧастиформы");
	
	// ДобавлениеКоманд
	МассивИменМетодов.Добавить("НоваяКнопкаФормы");
	МассивИменМетодов.Добавить("НоваяКомандаИГиперссылкаФормы");
	МассивИменМетодов.Добавить("НоваяКомандаИКнопкаКоманднойПанели");	
	МассивИменМетодов.Добавить("НоваяКомандаИКнопкаФормы");
	МассивИменМетодов.Добавить("НоваяКомандаФормы");
	
	// ДобавлениеРеквизитовОбъекта
	МассивИменМетодов.Добавить("НовыйРеквизитОбъектаФормы");
	МассивИменМетодов.Добавить("НовоеПолеФормыРеквизитОбъекта");
	МассивИменМетодов.Добавить("НовоеПолеШапкиФормыРеквизитОбъекта");
	МассивИменМетодов.Добавить("НовоеМногострочноеПолеРеквизитОбъекта");
	МассивИменМетодов.Добавить("НовоеПолеФлажокФормыРеквизитОбъекта");
	МассивИменМетодов.Добавить("НоваяГруппаКнопок");
	
	// ДобавлениеРеквизитовИЭлементвоНаФорму
	МассивИменМетодов.Добавить("НовыйДинамическийСписокФормы");
	
	// ДобавлениеДекораций
	МассивИменМетодов.Добавить("НоваяДекорацияНадпись");
	
	
	Для Каждого ИмяМетода Из МассивИменМетодов Цикл
		НоваяСтрока = Объект.ПроверяемыеПроцедурыИФункции.Добавить();
		НоваяСтрока.ИмяМетода = ИмяМетода;
	КонецЦикла;
	
	Объект.ВсегоПроцедурИФункций = Объект.ПроверяемыеПроцедурыИФункции.Количество();

КонецПроцедуры
	
#КонецОбласти
