&НаКлиенте
Функция ПрочитатьПротоколUITest(ФормаТестКлиента)
	ПолеПротокола = ФормаТестКлиента.НайтиОбъект(Тип("ТестируемоеПолеФормы"), "Статус | ID | проверка*", , 5);
	Если ПолеПротокола = Неопределено Тогда
		Возврат "protocol field not found";
	КонецЕсли;
	Возврат ПолеПротокола.ПолучитьПредставлениеДанных();
КонецФункции

&НаКлиенте
Функция ПрочитатьОшибкиПодготовкиUITest(ФормаТестКлиента)
	СтрокиПротокола = СтрРазделить(ПрочитатьПротоколUITest(ФормаТестКлиента), Символы.ПС, Ложь);
	Для Каждого СтрокаПротокола Из СтрокиПротокола Цикл
		Если Лев(СтрокаПротокола, СтрДлина("UI_FIXTURE_SETUP=")) = "UI_FIXTURE_SETUP=" Тогда
			ОшибкаПодготовкиUITest = СтрЗаменить(СтрокаПротокола, "UI_FIXTURE_SETUP=", "");
			Возврат ?(ОшибкаПодготовкиUITest = "OK", "", ОшибкаПодготовкиUITest);
		КонецЕсли;
	КонецЦикла;
	Возврат "setup marker not found";
КонецФункции

&НаКлиенте
Функция ВыполнитьСценарийTestClient(ТестКлиент, ФормаТестКлиента, Идентификатор,
	КаталогСнимков, ПутьКСкриптуСнимка, ИДПроцессаTestClient) Экспорт

#Если ТолстыйКлиентУправляемоеПриложение Тогда
	СтатусПроверки = "FAIL";
	ОписаниеСценария = "TestClient UI interaction";
	ОжидаемыйРезультат = "";
	ФактическийРезультат = "";
	ТекстОшибки = "";
	Попытка
		Если Идентификатор = "UI_FieldInput_ButtonClick" Тогда
			ОписаниеСценария = "НовоеПолеФормы: ввод TestClient и клик НоваяКомандаИКнопкаФормы";
			ОжидаемыйРезультат = "form-button:native-ui-test-value";
			ПолеВвода = ФормаТестКлиента.НайтиОбъект(Тип("ТестируемоеПолеФормы"), "UI_TEST_INPUT*", , 5);
			Если ПолеВвода = Неопределено Тогда
				ВызватьИсключение "TestClient object not found: type=ТестируемоеПолеФормы, title=UI_TEST_INPUT*";
			КонецЕсли;
			ПолеВвода.Активизировать();
			ПолеВвода.ВвестиТекст("native-ui-test-value");
			ПолеРезультата = ФормаТестКлиента.НайтиОбъект(Тип("ТестируемоеПолеФормы"), "UI_TEST_RESULT", , 5);
			Если ПолеРезультата = Неопределено Тогда
				ВызватьИсключение "TestClient object not found: type=ТестируемоеПолеФормы, title=UI_TEST_RESULT";
			КонецЕсли;
			// Смена фокуса завершает редактирование поля перед проверкой обработчика.
			ПолеРезультата.Активизировать();
			КнопкаПрименить = ФормаТестКлиента.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "UI_TEST_APPLY", , 5);
			Если КнопкаПрименить = Неопределено Тогда
				ВызватьИсключение "TestClient object not found: type=ТестируемаяКнопкаФормы, title=UI_TEST_APPLY; setup=" + ПрочитатьПротоколUITest(ФормаТестКлиента);
			КонецЕсли;
			КнопкаПрименить.Нажать();
			ПолеРезультата = ФормаТестКлиента.НайтиОбъект(Тип("ТестируемоеПолеФормы"), "UI_TEST_RESULT", , 5);
			ПолеСвидетельства = ФормаТестКлиента.НайтиОбъект(Тип("ТестируемоеПолеФормы"), "Статус | ID | проверка*", , 5);
			СтрокиСвидетельства = СтрРазделить(ПолеСвидетельства.ПолучитьПредставлениеДанных(), Символы.ПС, Ложь);
			ФактическийРезультат = ПолеРезультата.ПолучитьПредставлениеДанных() + "|" + СтрокиСвидетельства[0];
			ОжидаемыйРезультат = "form-button:native-ui-test-value|UI_TEST_RESULT=form-button:native-ui-test-value";
		ИначеЕсли Идентификатор = "UI_DirectButtonClick" Тогда
			ОписаниеСценария = "НоваяКомандаФормы + НоваяКнопкаФормы: клик вложенной в группу кнопки и действие";
			ОжидаемыйРезультат = "direct-button:native-ui-test-value";
			ПолеВвода = ФормаТестКлиента.НайтиОбъект(Тип("ТестируемоеПолеФормы"), "UI_TEST_INPUT", , 5);
			ПолеРезультата = ФормаТестКлиента.НайтиОбъект(Тип("ТестируемоеПолеФормы"), "UI_TEST_RESULT", , 5);
			ГруппаКнопокTestClient = ФормаТестКлиента.НайтиОбъект(Тип("ТестируемаяГруппаФормы"), , "UIProbeGroup", 5);
			Если ГруппаКнопокTestClient = Неопределено Тогда
				ВызватьИсключение "TestClient direct button parent not found: name=UIProbeGroup; setup=" + ПрочитатьПротоколUITest(ФормаТестКлиента);
			КонецЕсли;
			// Ищем кнопку через фактическую родительскую группу, а не глобально на форме.
			КнопкаТестовая = ГруппаКнопокTestClient.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "UI_TEST_DIRECT_BUTTON", , 5);
			Если ПолеВвода = Неопределено Или ПолеРезультата = Неопределено Или КнопкаТестовая = Неопределено Тогда
				ВызватьИсключение "TestClient object not found: direct button scenario requires UI_TEST_INPUT, UI_TEST_RESULT and UI_TEST_DIRECT_BUTTON inside UIProbeGroup; setup=" + ПрочитатьПротоколUITest(ФормаТестКлиента);
			КонецЕсли;
			ПолеВвода.Активизировать(); ПолеВвода.ВвестиТекст("native-ui-test-value");
			ПолеРезультата.Активизировать();
			КнопкаТестовая.Нажать();
			ПолеРезультата = ФормаТестКлиента.НайтиОбъект(Тип("ТестируемоеПолеФормы"), "UI_TEST_RESULT", , 5);
