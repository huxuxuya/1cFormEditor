#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Отчёт создаётся средствами платформы, независимо от проверяемого модуля.
	Итог = Элементы.Добавить("ИтогАвтотестов", Тип("ДекорацияФормы"));
	Итог.Заголовок = "Автотесты ещё не запущены";
	ПолеОтчета = Элементы.Добавить("ПротоколАвтотестов", Тип("ПолеФормы"));
	ПолеОтчета.ПутьКДанным = "ПротоколАвтотестов";
	ПолеОтчета.Вид = ВидПоляФормы.ПолеВвода;
	ПолеОтчета.МногострочныйРежим = Истина;
	ПолеОтчета.ТолькоПросмотр = Истина;
	ПолеОтчета.АвтоМаксимальнаяШирина = Ложь;
	ПолеОтчета.Ширина = 150;
	ПолеОтчета.Высота = 17;
	ПолеОтчета.Заголовок = "Статус | ID | проверка | ожидалось | фактически | ошибка";
	КомандаПовтора = Команды.Добавить("ПовторитьАвтотесты");
	КомандаПовтора.Действие = "ВыполнитьАвтотесты";
	КомандаПовтора.Заголовок = "Повторить автотесты";
	КнопкаПовтора = Элементы.Добавить("ПовторитьАвтотесты", Тип("КнопкаФормы"));
	КнопкаПовтора.ИмяКоманды = "ПовторитьАвтотесты";
	КомандаUITest = Команды.Добавить("ОткрытьUITestСтенд");
	КомандаUITest.Действие = "ОткрытьUITestСтенд";
	КомандаUITest.Заголовок = "Открыть UI стенд";
	КнопкаUITest = Элементы.Добавить("ОткрытьUITestСтенд", Тип("КнопкаФормы"));
	КнопкаUITest.ИмяКоманды = "ОткрытьUITestСтенд";
	Попытка
		СоздатьДемонстрационныеЭлементы();
	Исключение
		ОшибкаПодготовки = ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВыполнитьАвтотесты();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьUITestСтенд(Команда)
	ПротоколАвтотестов = "Подготовка динамических UI элементов";
	Попытка
		ПодготовитьUITestСтендНаСервере();
		Если ЗначениеЗаполнено(ОшибкаПодготовки) Тогда
			ПротоколАвтотестов = "UI fixture errors: " + ОшибкаПодготовки;
		Иначе
			ПротоколАвтотестов = "Динамические UI элементы созданы";
		КонецЕсли;
	Исключение
		ПротоколАвтотестов = "UI fixture error: " + ПонятнаяДиагностика(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ПодготовитьUITestСтендНаСервере()
	Если Элементы.Найти("UIProbeInput") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	СоздатьUITestЭлементы();
КонецПроцедуры

// Единственная точка запуска для ручной проверки и контейнерного прогона.
&НаКлиенте
Процедура ВыполнитьАвтотесты(Команда = Неопределено) Экспорт

	Результаты = Новый Массив;
	Попытка
		Результаты = ПроверитьДемонстрациюНаСервере();
	Исключение
		Результаты.Добавить(НовыйРезультатАвтотеста("СозданиеДемонстрации", "FAIL",
			ОписаниеПроверки("СозданиеДемонстрации"), "", "", ПонятнаяДиагностика(ОписаниеОшибки())));
	КонецПопытки;
	Для Каждого ИмяПроверяемойФормы Из СтрРазделить("ФормаРегрессии,ФормаПереименованная,ФормаНеоднозначная", ",") Цикл
		ФормаПроверки = Неопределено;
		Попытка
			// Новый ключ исключает повторное использование состояния прошлой проверки.
			ФормаПроверки = ПолучитьФорму("Обработка.TestForFormModificator.Форма." + ИмяПроверяемойФормы, , , Новый УникальныйИдентификатор);
			Если ИмяПроверяемойФормы = "ФормаРегрессии" Или ИмяПроверяемойФормы = "ФормаНеоднозначная" Тогда
			СтрокаРезультатовФормы = ФормаПроверки.РезультатыПроверокJSON;
			Если Не ЗначениеЗаполнено(СтрокаРезультатовФормы) Тогда
					ВызватьИсключение "Нет результатов регрессионных проверок";
				КонецЕсли;
				РезультатыФормы = ПрочитатьРезультатыJSONНаСервере(СтрокаРезультатовФормы);
				Если ТипЗнч(РезультатыФормы) <> Тип("Массив") Тогда
					ВызватьИсключение "Регрессионная форма вернула результат не в виде массива";
				КонецЕсли;
				Если РезультатыФормы.Количество() = 0 Тогда
					ВызватьИсключение "Регрессионная форма не вернула проверки";
				КонецЕсли;
				Для Каждого РезультатФормы Из РезультатыФормы Цикл
					Результаты.Добавить(РезультатФормы);
				КонецЦикла;
			Иначе
				Ожидаемо = "Форма открывается и её проверки выбора реквизита проходят";
				Фактически = "Форма открыта; проверки модуля формы завершились без исключений";
				Если ИмяПроверяемойФормы = "ФормаПереименованная" Тогда
					Ожидаемо = "Реквизит ДанныеОбъекта.РеквизитБулево найден как флажок; путь не переносится на следующее поле";
					Фактически = "Форма открыта; проверки привязки и следующего поля пройдены";
				ИначеЕсли ИмяПроверяемойФормы = "ФормаНеоднозначная" Тогда
					Ожидаемо = "Два объектных реквизита требуют явного выбора; выбор ВторойОбъект проверяет флажок и следующее поле";
					Фактически = "Неоднозначность обнаружена; явный выбор и следующие проверки пройдены";
				КонецЕсли;
				Результаты.Добавить(НовыйРезультатАвтотеста(ИмяПроверяемойФормы, "PASS",
					ОписаниеПроверки(ИмяПроверяемойФормы), Ожидаемо, Фактически, ""));
			КонецЕсли;
		Исключение
			Если ИмяПроверяемойФормы = "ФормаРегрессии" Тогда
				ДобавитьОшибкиРегрессии(Результаты, ПонятнаяДиагностика(ОписаниеОшибки()));
			ИначеЕсли ИмяПроверяемойФормы = "ФормаНеоднозначная" Тогда
				ДобавитьОшибкиНеоднозначности(Результаты, ПонятнаяДиагностика(ОписаниеОшибки()));
			Иначе
				Диагностика = ПонятнаяДиагностика(ОписаниеОшибки());
				Ожидаемо = "Форма открывается и её проверки выбора реквизита проходят";
				Фактически = "Проверка формы прервана исключением: " + Диагностика;
				Если ИмяПроверяемойФормы = "ФормаПереименованная" Тогда
					Ожидаемо = "Реквизит ДанныеОбъекта.РеквизитБулево найден как флажок; путь не переносится на следующее поле";
					Фактически = "Создание формы прервано до этих проверок: " + Диагностика;
				ИначеЕсли ИмяПроверяемойФормы = "ФормаНеоднозначная" Тогда
					Ожидаемо = "Два объектных реквизита требуют явного выбора; выбор ВторойОбъект проверяет флажок и следующее поле";
					Если СтрНайти(Диагностика, "Не обработана неоднозначность реквизитов") > 0 Тогда
						Фактически = "Неоднозначность не обнаружена; явный выбор и следующие проверки пройдены";
					КонецЕсли;
				КонецЕсли;
				Результаты.Добавить(НовыйРезультатАвтотеста(ИмяПроверяемойФормы, "FAIL",
					ОписаниеПроверки(ИмяПроверяемойФормы), Ожидаемо, Фактически, Диагностика));
			КонецЕсли;
		КонецПопытки;
		// Формы-проверки не открываются пользователю. Освобождаем ссылку.
		ФормаПроверки = Неопределено;
	КонецЦикла;
	Ошибок = 0;
	Для Каждого Результат Из Результаты Цикл
		Если Результат.status <> "PASS" Тогда
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;
	Если Ошибок = 0 И Результаты.Количество() > 0 Тогда
		Элементы.ИтогАвтотестов.Заголовок = "Все проверки пройдены: " + Результаты.Количество() + " из " + Результаты.Количество();
	Иначе
		Элементы.ИтогАвтотестов.Заголовок = "Проверки: " + (Результаты.Количество() - Ошибок) + " из " + Результаты.Количество() + " пройдены; ошибок " + Ошибок;
	КонецЕсли;
	ПротоколАвтотестов = СформироватьТекстовыйПротокол(Результаты);
	ОтчетАвтотестовJSON = СформироватьJSONОтчета(Результаты, Ошибок);

КонецПроцедуры

&НаКлиенте
Функция НовыйРезультатАвтотеста(Идентификатор, Статус, Описание, Ожидаемый = "", Фактический = "", Ошибка = "")
	Возврат Новый Структура("id,status,description,expected,actual,error",
		Идентификатор, Статус, Описание, Ожидаемый, Фактический, Ошибка);
КонецФункции

&НаКлиенте
Процедура ДобавитьОшибкиРегрессии(Результаты, ТекстОшибки)
	Идентификаторы = СтрРазделить("ОбщиеПроверки,ГруппаКнопок,Надпись,Команда,КнопкаПанели,Гиперссылка,ГруппаФормы,ГруппаКолонок,ПолеРеквизитаФормы,ПолеШапки,Флажок,ОшибкаДубликата,ДинамическийСписок,КонтекстПослеГруппы,КонтекстПослеФлажка,КонтекстПослеШапки,КонтекстПослеМногострочногоПоля,КонтекстПослеОшибки,ЯвныеСвойства,КонтекстЭлемента,ФормаПодготовлена,РазборСтроки", ",");
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Результаты.Добавить(НовыйРезультатАвтотеста(Идентификатор, "FAIL",
			ОписаниеПроверки(Идентификатор), "", "", "Регрессионная форма не вернула результаты: " + ТекстОшибки));
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОшибкиНеоднозначности(Результаты, ТекстОшибки)
	Для Каждого Идентификатор Из СтрРазделить("ФормаНеоднозначная,ФормаЯвныйВыборРеквизита", ",") Цикл
		Ожидаемо = "Исключение о нескольких объектных реквизитах";
		Если Идентификатор = "ФормаЯвныйВыборРеквизита" Тогда
			Ожидаемо = "Путь ВторойОбъект.РеквизитБулево и вид ПолеФлажка";
		КонецЕсли;
		Результаты.Добавить(НовыйРезультатАвтотеста(Идентификатор, "FAIL",
			ОписаниеПроверки(Идентификатор), Ожидаемо,
			"Форма не вернула результаты отдельных проверок: " + ТекстОшибки, ТекстОшибки));
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПрочитатьРезультатыJSONНаСервере(СтрокаJSON)
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	РезультатыJSON = ПрочитатьJSON(ЧтениеJSON, Истина);
	Если ТипЗнч(РезультатыJSON) <> Тип("Массив") Тогда
		ВызватьИсключение "Регрессионный JSON не содержит массив результатов";
	КонецЕсли;
	Результаты = Новый Массив;
	Для Каждого РезультатJSON Из РезультатыJSON Цикл
		Результаты.Добавить(Новый Структура("id,status,description,expected,actual,error",
			РезультатJSON["id"], РезультатJSON["status"], РезультатJSON["description"],
			РезультатJSON["expected"], РезультатJSON["actual"], РезультатJSON["error"]));
	КонецЦикла;
	Возврат Результаты;
КонецФункции

&НаСервере
Функция СформироватьJSONОтчета(Результаты, Ошибок)
	Отчет = Новый Структура;
	Отчет.Вставить("schema_version", 1);
	Отчет.Вставить("suite", "FormEditor");
	Отчет.Вставить("status", ?(Ошибок = 0 И Результаты.Количество() > 0, "PASS", "FAIL"));
	Отчет.Вставить("results", Результаты);
	Отчет.Вставить("totals", Новый Структура("total,passed,failed",
		Результаты.Количество(), Результаты.Количество() - Ошибок, Ошибок));
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Отчет);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

&НаКлиенте
Функция СформироватьТекстовыйПротокол(Результаты)
	Строки = Новый Массив;
	Строки.Добавить("Статус | Проверка | Ожидалось | Фактически | Ошибка");
	Для Каждого Результат Из Результаты Цикл
		СтрокаРезультата = Результат.status + " | " + Результат.id + " | " + Результат.description;
		Если ЗначениеЗаполнено(Результат.expected) Тогда
			СтрокаРезультата = СтрокаРезультата + " | ожидалось: " + Результат.expected;
		КонецЕсли;
		Если ЗначениеЗаполнено(Результат.actual) Тогда
			СтрокаРезультата = СтрокаРезультата + " | фактически: " + Результат.actual;
		КонецЕсли;
		Если ЗначениеЗаполнено(Результат.error) Тогда
			СтрокаРезультата = СтрокаРезультата + " | ошибка: " + Результат.error;
		КонецЕсли;
		Строки.Добавить(СтрокаРезультата);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

&НаСервере
Функция ПроверитьДемонстрациюНаСервере()

	Результаты = Новый Массив;
	Если ЗначениеЗаполнено(ОшибкаПодготовки) Тогда
		Результаты.Добавить(Новый Структура("id,status,description,expected,actual,error",
			"СозданиеДемонстрации", "FAIL", "Создание демонстрационных элементов", "", "", СтрЗаменить(ОшибкаПодготовки, Символы.ПС, " ")));
		Возврат Результаты;
	КонецЕсли;
	ДобавитьРезультатПроверки(Результаты, "СозданиеДемонстрации", Истина,
		"Вызов создания демонстрационной формы и тестовых элементов", "завершился без исключения", "без исключения");
	ФактическийПуть = Элементы.РеквизитСтрока.ПутьКДанным;
	ДобавитьРезультатПроверки(Результаты, "ПривязкаПоля", ФактическийПуть = "Объект.РеквизитСтрока",
		"ПутьКДанным поля РеквизитСтрока", ФактическийПуть, "Объект.РеквизитСтрока");
	ФактическийВид = Строка(Элементы.Флажок.Вид);
	ДобавитьРезультатПроверки(Результаты, "ВидФлажка", Элементы.Флажок.Вид = ВидПоляФормы.ПолеФлажка,
		"Вид элемента Флажок", ФактическийВид, "Поле флажка");
	ФактическоеКоличество = Элементы.РеквизитСтрока.СписокВыбора.Количество();
	ДобавитьРезультатПроверки(Результаты, "СписокВыбора", ФактическоеКоличество = 2,
		"Количество вариантов списка у поля РеквизитСтрока", Строка(ФактическоеКоличество), "2");
	ФактическоеДействие = Команды.Подключаемый_КомандаКнопки1.Действие;
	ДобавитьРезультатПроверки(Результаты, "ДействиеКоманды", ФактическоеДействие = "Подключаемый_КомандаКнопки1",
		"Действие команды Подключаемый_КомандаКнопки1", ФактическоеДействие, "Подключаемый_КомандаКнопки1");
	Возврат Результаты;

КонецФункции

&НаСервере
Процедура ДобавитьРезультатПроверки(Результаты, Имя, Условие, ЧтоПроверяется, ФактическийРезультат, ОжидаемыйРезультат)
	Статус = ?(Условие, "PASS", "FAIL");
	Результаты.Добавить(Новый Структура("id,status,description,expected,actual,error",
		Имя, Статус, ЧтоПроверяется, ОжидаемыйРезультат, ФактическийРезультат, ""));
КонецПроцедуры

&НаКлиенте
Функция ПонятнаяДиагностика(ТекстОшибки)

	МаркерПроверки = "Ошибка регрессионной проверки: ";
	ПозицияМаркера = СтрНайти(ТекстОшибки, МаркерПроверки);
	Если ПозицияМаркера > 0 Тогда
		Возврат "не пройдено условие «" + СокрЛП(Сред(ТекстОшибки, ПозицияМаркера + СтрДлина(МаркерПроверки))) + "»";
	КонецЕсли;

	ПозицияПути = СтрНайти(ТекстОшибки, "}: ");
	Если ПозицияПути > 0 Тогда
		ТекстОшибки = Сред(ТекстОшибки, ПозицияПути + 3);
	КонецЕсли;
	Возврат СтрЗаменить(ТекстОшибки, Символы.ПС, " ");

КонецФункции

&НаКлиенте
Функция ОписаниеПроверки(Имя)

	Описания = Новый Структура;
	Описания.Вставить("СозданиеДемонстрации", "создание демонстрационной формы и элементов");
	Описания.Вставить("ПривязкаПоля", "путь поля РеквизитСтрока должен вести к реквизиту объекта");
	Описания.Вставить("ВидФлажка", "тип элемента для булевого реквизита должен быть ПолеФлажка");
	Описания.Вставить("СписокВыбора", "у поля должны быть два варианта списка выбора");
