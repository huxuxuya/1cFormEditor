        РодительПанелиUITest = ТаблицаПанелиUITest.КоманднаяПанель;
        КонтекстПанелиUITest = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект, РодительПанелиUITest);
        КнопкаUITest = РедакторФорм.НоваяКомандаИКнопкаКоманднойПанели(КонтекстПанелиUITest, "UIProbePanel", "UI_TEST_PANEL_BUTTON");
