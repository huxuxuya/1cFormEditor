    КонтекстUITest.Свойства = Новый Структура("ПутьКДанным,Заголовок", "UIProbeFormValue", "UI_TEST_FORM_BOUND_FIELD");
    РедакторФорм.НовоеПолеРеквизитаФормы(КонтекстUITest, "UIProbeFormBoundField");
    КонтекстUITest.Свойства = Новый Структура("ПутьКДанным,Заголовок", "Объект.РеквизитСтрока", "UI_TEST_OBJECT_BOUND_FIELD");
    РедакторФорм.НовоеПолеФормыРеквизитОбъекта(КонтекстUITest, "UIProbeObjectBoundField");
    КонтекстUITest.Свойства = Новый Структура("ПутьКДанным,Заголовок", "Объект.РеквизитШапки", "UI_TEST_HEADER_FIELD");
    РедакторФорм.НовоеПолеШапкиФормыРеквизитОбъекта(КонтекстUITest, "UIProbeHeaderField");
