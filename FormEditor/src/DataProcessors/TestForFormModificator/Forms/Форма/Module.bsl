    Исключение
        ДобавитьОшибкаПодготовкиUITest("UIProbePanel: " + ОписаниеОшибки());
    КонецПопытки;
    Попытка
        КнопкаUITest = РедакторФорм.НоваяКомандаИГиперссылкаФормы(КонтекстКнопокUITest, "UIProbeHyperlink", "Подключаемый_UIProbeHyperlink", "UI_TEST_HYPERLINK");
        КнопкаUITest.Заголовок = "UI_TEST_HYPERLINK";
    Исключение
        ДобавитьОшибкаПодготовкиUITest("UIProbeHyperlink: " + ОписаниеОшибки());
    КонецПопытки;
    Попытка
        КнопкаUITest = РедакторФорм.НоваяКомандаИКнопкаФормы(КонтекстКнопокUITest, "UIProbeApply", "UI_TEST_APPLY");
        КнопкаUITest.Заголовок = "UI_TEST_APPLY";
    Исключение
        ДобавитьОшибкаПодготовкиUITest("UIProbeApply: " + ОписаниеОшибки());
    КонецПопытки;

    Попытка
        КонтекстДекорацииUITest = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект, Элементы.ГруппаМногострочноеПоле);
