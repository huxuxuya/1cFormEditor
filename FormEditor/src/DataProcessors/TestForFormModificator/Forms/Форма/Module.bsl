	ДобавитьКСчетчикуПоМетоду("НовоеПолеФормыРеквизитОбъекта", , 1);
		
	КонтекстФормыПоле = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект, ЛеваяПодгруппаЛево);	
