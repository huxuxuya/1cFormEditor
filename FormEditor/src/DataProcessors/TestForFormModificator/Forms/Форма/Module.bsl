&НаКлиенте
Процедура ЗафиксироватьРезультатUITest(Результат)
	UIProbeOutputValue = Результат;
	// Это независимый статический свидетель вызова обработчика на форме тест-клиента.
	ПротоколАвтотестов = "UI_TEST_RESULT=" + Результат + Символы.ПС +
		"UI_FIXTURE_SETUP=" + ?(ЗначениеЗаполнено(ОшибкаПодготовки), ОшибкаПодготовки, "OK");
