    РедакторФорм.НовоеМногострочноеПолеРеквизитОбъекта(КонтекстUITest, "UIProbeMultilineField");
    КонтекстUITest.Свойства = Новый Структура("ПутьКДанным,Заголовок", "Объект.Флажок", "UI_TEST_CHECKBOX_FIELD");
    РедакторФорм.НовоеПолеФлажокФормыРеквизитОбъекта(КонтекстUITest, "UIProbeCheckboxField");
    // Core button scenarios run before optional decoration/table/list fixtures.
    // Their captions are deterministic TestClient locators.
    КонтекстКнопокUITest = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект, ГруппаUITest);
    ГруппаКнопокUITest = Неопределено;
    Попытка
        ГруппаКнопокUITest = РедакторФорм.НоваяГруппаКнопок(КонтекстКнопокUITest);
    Исключение
        ДобавитьОшибкаПодготовкиUITest(ОписаниеОшибки());
