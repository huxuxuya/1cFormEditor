    Исключение
        ДобавитьОшибкаПодготовкиUITest("UIProbeLabel: " + ОписаниеОшибки());
    КонецПопытки;

    Попытка
        ТекстЗапросаUITest = "ВЫБРАТЬ
                        | 1 КАК Номер
                        |
                        |ОБЪЕДИНИТЬ ВСЕ
                        |
                        |ВЫБРАТЬ
                        | 2";
        СвойстваСпискаUITest = Новый Структура("ТекстЗапроса,ПроизвольныйЗапрос", ТекстЗапросаUITest, Истина);
        КонтекстСпискаUITest = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект, Элементы.ГруппаМногострочноеПоле, , СвойстваСпискаUITest);
        РедакторФорм.НовыйДинамическийСписокФормы(КонтекстСпискаUITest, "UIProbeList", "");
        КолонкиСпискаUITest = Новый Структура("UIProbeNumber", "Номер");
        КонтекстСпискаUITest.Свойства = Новый Структура("Заголовок", "UI_TEST_DYNAMIC_LIST");
        ТаблицаСпискаUITest = РедакторФорм.НоваяТаблицаФормы(КонтекстСпискаUITest, "UIProbeListTable", "UIProbeList", КолонкиСпискаUITest);
        ТаблицаСпискаUITest.Заголовок = "UI_TEST_DYNAMIC_LIST";
        // Use a dedicated dynamic-list column so this creator gets a unique form element name.
        КонтекстСпискаUITest.Родитель = ТаблицаСпискаUITest;
        КонтекстСпискаUITest.Свойства = Новый Структура;
        РедакторФорм.НовоеПолеТабличнойЧастиформы(КонтекстСпискаUITest, "UIProbeList", "Номер");
    Исключение
        ДобавитьОшибкаПодготовкиUITest("UIProbeList: " + ОписаниеОшибки());
    КонецПопытки;

    // Group columns are last so their platform error cannot suppress other UI cases.
    Попытка
        // The existing regression uses this creator successfully at the form root.
        КонтекстUITest = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект);
        ГруппаUIColumns = РедакторФорм.НоваяГруппаКолонкиЛевоПраво(КонтекстUITest, "UIProbeColumns");
        ГруппаUIColumns.Заголовок = "UI_TEST_COLUMNS";
        ГруппаUIColumns.ОтображатьЗаголовок = Истина;
        // Give both column groups real visible content so effective parent visibility is observable.
        КонтекстКолонкиUITest = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект, Элементы.Найти("UIProbeColumnsЛево"));
        РедакторФорм.НоваяДекорацияНадпись(КонтекстКолонкиUITest, "UIProbeColumnLeftLabel", "UI_TEST_COLUMN_LEFT");
        КонтекстКолонкиUITest = РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект, Элементы.Найти("UIProbeColumnsПраво"));
        РедакторФорм.НоваяДекорацияНадпись(КонтекстКолонкиUITest, "UIProbeColumnRightLabel", "UI_TEST_COLUMN_RIGHT");
    Исключение
        ДобавитьОшибкаПодготовкиUITest("UIProbeColumns: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры

