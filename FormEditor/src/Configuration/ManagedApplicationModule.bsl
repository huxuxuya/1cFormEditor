Процедура ПриНачалеРаботыСистемы()
#Если ТолстыйКлиентУправляемоеПриложение Или ТонкийКлиент Тогда
	Префикс = "FormEditorRegression=";
	Если Лев(ПараметрЗапуска, СтрДлина(Префикс)) <> Префикс Тогда
		ОткрытьФорму("Обработка.TestForFormModificator.Форма.Форма");
		Возврат;
	КонецЕсли;
	Отчет = Новый ЗаписьТекста(Сред(ПараметрЗапуска, СтрДлина(Префикс) + 1), КодировкаТекста.UTF8);
	Попытка
		ФормаТеста = ПолучитьФорму("Обработка.TestForFormModificator.Форма.Форма");
		ФормаТеста.ВыполнитьАвтотесты();
		Отчет.ЗаписатьСтроку(ФормаТеста.ПротоколАвтотестов);
	Исключение
		Отчет.ЗаписатьСтроку("FAIL ЗапускТестов: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Отчет.Закрыть();
	ЗавершитьРаботуСистемы(Ложь);
#КонецЕсли
КонецПроцедуры
