Процедура ПриНачалеРаботыСистемы()
#Если ТолстыйКлиентУправляемоеПриложение Или ТонкийКлиент Тогда
	ПрефиксUITest = "FormEditorUITest=";
	Если Лев(ПараметрЗапуска, СтрДлина(ПрефиксUITest)) = ПрефиксUITest Тогда
		ПараметрыЗапускаUITest = СтрРазделить(Сред(ПараметрЗапуска, СтрДлина(ПрефиксUITest) + 1), "|");
		Если ПараметрыЗапускаUITest.Количество() <> 5 Тогда
			ВызватьИсключение "Некорректный параметр запуска TestManager UI";
		КонецЕсли;
		ПортUITest = Число(ПараметрыЗапускаUITest[0]);
		ПутьКОтчетуUITest = ПараметрыЗапускаUITest[1];
		КаталогСнимковUITest = ПараметрыЗапускаUITest[2];
		ПутьКСкриптуСнимкаUITest = ПараметрыЗапускаUITest[3];
		ИДПроцессаTestClient = Число(ПараметрыЗапускаUITest[4]);
		ОтчетUITest = Новый ЗаписьТекста(ПутьКОтчетуUITest, КодировкаТекста.UTF8);
		Попытка
			ФормаUITest = ПолучитьФорму("Обработка.TestForFormModificator.Форма.Форма");
			ОтчетUITest.ЗаписатьСтроку(ФормаUITest.ВыполнитьПроверкуTestClient(
				ПортUITest, КаталогСнимковUITest, ПутьКСкриптуСнимкаUITest, ИДПроцессаTestClient));
		Исключение
			ОтчетUITest.Закрыть();
			ДиагностикаUITest = Новый ЗаписьТекста(ПутьКОтчетуUITest + ".error.txt", КодировкаТекста.UTF8);
			ДиагностикаUITest.ЗаписатьСтроку(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ДиагностикаUITest.Закрыть();
			ЗавершитьРаботуСистемы(Ложь);
			Возврат;
		КонецПопытки;
		ОтчетUITest.Закрыть();
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;
	Префикс = "FormEditorRegression=";
	Если Лев(ПараметрЗапуска, СтрДлина(Префикс)) <> Префикс Тогда
		ОткрытьФорму("Обработка.TestForFormModificator.Форма.Форма");
		Возврат;
	КонецЕсли;
	ПутьКОтчету = Сред(ПараметрЗапуска, СтрДлина(Префикс) + 1);
	Отчет = Новый ЗаписьТекста(ПутьКОтчету, КодировкаТекста.UTF8);
	Попытка
		ФормаТеста = ПолучитьФорму("Обработка.TestForFormModificator.Форма.Форма");
		ФормаТеста.ВыполнитьАвтотесты();
		Отчет.ЗаписатьСтроку(ФормаТеста.ОтчетАвтотестовJSON);
	Исключение
		Отчет.Закрыть();
		Диагностика = Новый ЗаписьТекста(ПутьКОтчету + ".error.txt", КодировкаТекста.UTF8);
		Диагностика.ЗаписатьСтроку(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Диагностика.Закрыть();
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецПопытки;
	Отчет.Закрыть();
	ЗавершитьРаботуСистемы(Ложь);
#КонецЕсли
КонецПроцедуры
